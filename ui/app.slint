// Oberfläche von MediaFiles Check (gleicher Look wie MediaFiles Ferry). Texte auf Englisch in @tr(); Deutsch in translations/.
import { Palette, Spinner } from "std-widgets.slint";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

export struct MenuChoice {
    title: string,
    checked: bool,
}

export struct HelpBlock {
    heading: string,
    body: styled-text,
    // screenshot (2x pixels), shown at half its pixel size, never wider than the text
    picture: image,
}

export struct DriveRow {
    name: string,
    selected: bool,
}

// Ordner, der für Media Composer umbenannt wird: from → to
export struct RenameRow {
    from: string,
    to: string,
}

// umbenannter Ordner; status: 0 Laufwerk fehlt, 1 wartet auf Media Composer, 2 bereit
export struct RenamedRow {
    current: string,
    original: string,
    status: int,
}

// Zeile im Abschlussbericht; kind: 0 zurückbenannt a → b, 1 n neue Dateien nach a verschoben,
// 2 a bleibt umbenannt, 3 Fehler bei a: b, 4 nicht verschoben (gibt es im Ziel schon): a
export struct NoticeRow {
    kind: int,
    a: string,
    b: string,
    n: int,
}

// level: 0 Ordner, 1 Befund, 2 Dateiname
// Selbsttest: eine Zeile pro Prüfung; status 0 bestanden, 1 Fehler, 2 übersprungen
export struct TestRow {
    title: string,
    detail: string,
    status: int,
}

export struct ReportRow {
    text: string,
    level: int,
}

// Fehlende Medien: level 0 Bin, 1 Mediendatei (aufklappbar, index für toggle-group), 2 Verwendung im Bin
export struct MissingRow {
    level: int,
    text: string,
    note: string,
    open: bool,
    index: int,
}

export global Metrics {
    out property <length> window-width: 420px;
    out property <length> padding: 32px;
    out property <length> spacing: 24px;
    out property <length> line: 18px;
    // umbrechende Texte brauchen eine feste Breite, sonst rechnet Slint sie als eine Zeile
    out property <length> content-width: 800px - 173px - 2 * 24px;
}

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #1f2225 : #f5f5f3;
    out property <color> text: dark ? #eceded : #17191b;
    out property <color> muted: dark ? #a9adb1 : #3f444a;
    out property <color> faint: dark ? #858b91 : #60666c;   // dark 4.6:1 (WCAG AA)
    out property <color> line: dark ? #3a3f44 : #c4c8cc;
    out property <color> disabled: dark ? #6a7076 : #70767c;
    out property <color> primary: dark ? #e6e7e8 : #2e3236;
    out property <color> on-primary: dark ? #1f2225 : #f5f5f3;
    out property <color> online: dark ? #3fb950 : #1a7f37;   // light 4.7:1
    out property <color> warning: dark ? #d29922 : #8a5a00;
    out property <color> error: dark ? #f85149 : #c62828;
    // partial wie Mountpoint (Rahmen des Fehler-Toasts); accent = Systemblau des aktiven Reiters
    out property <color> partial: dark ? #f0883e : #b4530f;
    out property <color> accent: dark ? #0a84ff : #007aff;
    // Hauptfenster: Seitenleiste und Auswahl darin
    out property <color> sidebar: dark ? #232629 : #ececea;
    out property <color> selection: dark ? #34393e : #dcdcd9;
}

component Headline inherits VerticalLayout {
    padding-top: 8px;
    padding-bottom: 12px;
    Text {
        text: "MEDIAFILES CHECK";
        font-family: "Helvetica Neue";
        font-size: 31px;
        font-weight: 300;
        letter-spacing: 2.5px;
        color: Theme.text;
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    Text {
        text: root.title;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: Theme.muted;
    }
    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

component StatusLine inherits Text {
    height: Metrics.line;
    font-size: 12px;
    overflow: elide;
    vertical-alignment: center;
}

component Para inherits Text {
    width: Metrics.content-width - 12px;
    wrap: word-wrap;
    font-size: 12px;
    color: Theme.muted;
}

component Dot inherits VerticalLayout {
    in property <color> color;
    alignment: center;
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.color;
    }
}

component CheckButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    // 26 px wie Mountpoints FerryButtonStyle in den Einstellungen (Schrift 12, 12 px Rand), sonst 32 px wie Ferry
    in property <bool> small;
    callback clicked;
    min-width: label.preferred-width + (root.small ? 24px : 28px);
    preferred-width: self.min-width;
    height: root.small ? 26px : 32px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: root.primary && root.enabled ? Theme.primary : Theme.line;
        background: !root.enabled ? transparent
            : root.primary ? (touch.pressed ? Theme.primary.darker(0.15) : Theme.primary)
            : touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    label := Text {
        text: root.text;
        font-size: root.small ? 12px : 13px;
        // small = Einstellungen: CoreText zeichnet Mountpoints Knopftext deutlich kräftiger als Slint
        font-weight: root.small ? (root.primary ? 700 : 600) : root.primary ? 600 : 400;
        color: !root.enabled ? Theme.disabled : root.primary ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Schalter wie in Mountpoint: Kapsel 34 × 20, Knopf rechts = an
component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled;
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.primary : Theme.line;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Theme.on-primary : (Theme.dark ? Theme.muted : Theme.background);
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Auswahl wie Mountpoints Dropdown: Knopf im Ferry-Stil (26 px) mit Titel und Pfeil, darunter das native Menü;
// der aktuelle Eintrag ist ausgegraut.
component Dropdown {
    in property <[string]> items;
    in property <int> current;
    callback selected(int);
    height: 26px;
    // so breit wie der Inhalt, wie Mountpoints .fixedSize()
    min-width: row.preferred-width;
    max-width: row.preferred-width;
    horizontal-stretch: 0;
    accessible-role: combobox;
    accessible-value: root.items[root.current];
    accessible-action-default => { menu.show({ x: 0, y: root.height + 4px }); }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        background: touch.pressed ? Theme.text.with-alpha(0.12) : touch.has-hover ? Theme.text.with-alpha(0.06) : transparent;
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.items[root.current];
            font-size: 12px;
            vertical-alignment: center;
            color: Theme.text;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 8px;
                height: 5px;
                commands: "M 0 0 L 4 4 L 8 0";
                stroke: Theme.text;
                stroke-width: 1.5px;
            }
        }
    }
    menu := ContextMenuArea {
        Menu {
            for item[i] in root.items: MenuItem {
                title: item;
                enabled: i != root.current;
                activated => { root.selected(i); }
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { menu.show({ x: 0, y: root.height + 4px }); }
        }
    }
}

component ScrollThumb inherits Rectangle {
    in property <length> view;
    in property <length> content;
    in property <length> offset;
    visible: root.content > root.view;
    width: 6px;
    height: max(24px, (root.view - 4px) * root.view / max(root.content, 1px));
    y: 2px + (root.content > root.view ? -root.offset / (root.content - root.view) * (root.view - 4px - self.height) : 0px);
    border-radius: 3px;
    background: Theme.dark ? #ffffff59 : #00000059;
}

// Liste mit Scrollfläche bis `limit`, darüber Scrollbalken wie im Problem-Feld; Platz für den Balken nur wenn nötig
component ScrollBox inherits Rectangle {
    in property <length> limit: 300px;
    in property <length> spacing: 0px;
    property <bool> scrolls: inner.preferred-height > root.limit;
    height: min(inner.preferred-height, root.limit);
    flick := Flickable {
        content-height: inner.preferred-height;
        inner := VerticalLayout {
            x: 0;
            width: flick.width - (root.scrolls ? 12px : 0px);
            spacing: root.spacing;
            @children
        }
    }
    ScrollThumb { x: parent.width - self.width - 2px; view: flick.height; content: inner.preferred-height; offset: flick.content-y; }
}

// Ergebnisliste mit eigener Scrollfläche; level: 0 Überschrift, 1 Befund (Warnfarbe), 2 Detail (eingerückt)
component RowList inherits Rectangle {
    in property <[ReportRow]> rows;
    in property <length> limit: 360px;
    height: min(list.preferred-height, root.limit);
    flick := Flickable {
        content-height: list.preferred-height;
        list := VerticalLayout {
            x: 0;
            width: flick.width - 10px;
            spacing: 4px;
            for r[i] in root.rows: VerticalLayout {
                padding-top: r.level == 0 && i > 0 ? 10px : 0;
                padding-left: r.level == 2 ? 16px : 0;
                Text {
                    width: Metrics.content-width - 12px - (r.level == 2 ? 16px : 0);
                    text: r.text;
                    wrap: word-wrap;
                    font-size: 12px;
                    font-weight: r.level == 0 ? 600 : 400;
                    color: r.level == 0 ? Theme.text : r.level == 1 ? Theme.warning : Theme.muted;
                }
            }
        }
    }
    ScrollThumb { x: parent.width - self.width - 2px; view: flick.height; content: list.preferred-height; offset: flick.content-y; }
}

// Fehlende Mediendateien pro Bin, Klick auf eine Datei klappt auf, wo sie im Bin steckt
component MissingList inherits Rectangle {
    in property <[MissingRow]> rows;
    in property <length> limit: 360px;
    callback toggle(int);
    height: min(list.preferred-height, root.limit);
    flick := Flickable {
        content-height: list.preferred-height;
        list := VerticalLayout {
            x: 0;
            width: flick.width - 10px;
            for r[i] in root.rows: Rectangle {
                height: line.preferred-height;
                line := HorizontalLayout {
                    padding-top: r.level == 0 && i > 0 ? 14px : 3px;
                    padding-bottom: 3px;
                    padding-left: r.level == 2 ? 34px : r.level == 1 ? 8px : 0;
                    spacing: 8px;
                    if r.level == 1: VerticalLayout {
                        alignment: center;
                        Path {
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            commands: r.open ? "M 0 1 L 8 1 L 4 7 Z" : "M 1 0 L 7 4 L 1 8 Z";
                            fill: Theme.muted;
                        }
                    }
                    Text {
                        text: r.text;
                        horizontal-stretch: 1;
                        overflow: elide;
                        font-size: 12px;
                        font-weight: r.level == 0 ? 600 : 400;
                        color: r.level == 2 ? Theme.muted : Theme.text;
                    }
                    Text {
                        text: r.note;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                }
                if r.level == 1: TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle(r.index); }
                }
            }
        }
    }
    ScrollThumb { x: parent.width - self.width - 2px; view: flick.height; content: list.preferred-height; offset: flick.content-y; }
}

component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.primary;
    }
}

// Gemeinsam für alle Fenster: auf dem Mac gehört die Menüleiste zum aktiven Fenster.
export global Shared {
    // Größe des Fensters hat sich geändert (jedes Fenster hat sein eigenes Shared)
    callback resized();
    in property <[MenuChoice]> languages;
    in property <[string]> language-names;
    in property <int> language-index;
    in property <[bool]> appearance;
    in property <bool> dark: true;
    in property <bool> betas;
    // Rebalancing: höchstens so viele Mediendateien pro Ordner (Einstellungen → Rebalancing)
    in property <int> limit: 5000;
    callback select-limit(int);
    callback select-language(int);
    callback select-dark(bool);
    callback select-betas(bool);
    callback show-help();
    callback show-about();
    callback show-settings();
    callback show-log();
    // Updates (src/update.rs): laufende Version, neuere Version ("" = keine), Zustand 0 nichts, 1 prüft, 2 aktuell,
    // 3 installiert, 4 Fehler; Fehlerart 0 Prüfen, 1 Laden, 2 beschädigt, 3 Ersetzen, 4 Neustart
    in property <string> version;
    in property <string> update-version;
    in property <int> update-state;
    in property <int> update-error;
    in property <string> update-details;
    callback check-update();
    callback install-update();
    callback show-release();
    // Rust: Update-Zustand hat sich geändert, alle Fenster neu setzen
    callback refresh-update();
}

// Zustand der Updates als Text (Einstellungen und Banner)
component UpdateStatus inherits Text {
    width: Metrics.content-width;
    wrap: word-wrap;
    font-size: 12px;
    visible: self.text != "";
    height: self.visible ? self.preferred-height : 0;
    color: Shared.update-state == 4 ? Theme.error : Theme.muted;
    text: Shared.update-state == 1 ? @tr("Checking for updates…")
        : Shared.update-state == 2 ? @tr("MediaFiles Check is up to date.")
        : Shared.update-state == 3 ? @tr("Installing the update – MediaFiles Check restarts by itself.")
        : Shared.update-state != 4 ? ""
        : Shared.update-error == 0 ? @tr("Could not check for updates. Check the internet connection and try again.")
        : Shared.update-error == 1 ? @tr("The update could not be downloaded. Check the internet connection and try again.")
        : Shared.update-error == 2 ? @tr("The downloaded update is damaged. Please try again later or download it from GitHub.")
        : Shared.update-error == 3 ? @tr("MediaFiles Check could not replace itself. Move it to the Applications folder, or download the update from GitHub. Details: {}", Shared.update-details)
        : @tr("The update is installed. Quit MediaFiles Check and open it again to finish.");
}

// Neue Version: Hinweis mit "Neuigkeiten" und "Update installieren" (oben im Hauptfenster und in den Einstellungen)
component UpdateOffer inherits VerticalLayout {
    in property <length> text-width: Metrics.content-width;
    spacing: 10px;
    Text {
        width: root.text-width;
        wrap: word-wrap;
        text: @tr("Version {} is available.", Shared.update-version);
        font-weight: 600;
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        CheckButton {
            text: @tr("What's new");
            clicked => { Shared.show-release(); }
        }
        CheckButton {
            text: @tr("Install update");
            primary: true;
            enabled: Shared.update-state != 3;
            clicked => { Shared.install-update(); }
        }
    }
}

component CheckWindow inherits Window {
    default-font-family: "JetBrains Mono";
    default-font-size: 13px;
    background: Theme.background;

    property <bool> dark: Shared.dark;
    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    // Fenster, deren Höhe aus dem Inhalt kommt, wachsen; auf dem Mac malt Slint den neuen Bereich erst nach einem
    // weiteren Redraw – Rust zeichnet nach jeder Größenänderung nach (repaint_on_resize)
    changed height => { Shared.resized(); }

    MenuBar {
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Manual");
                activated => { Shared.show-help(); }
            }
            MenuItem {
                title: @tr("Show Log File");
                activated => { Shared.show-log(); }
            }
        }
    }
}

component SettingsTab {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    // kleiner oranger Punkt: dort wartet etwas (Hauptfenster)
    in property <bool> attention;
    callback clicked;
    min-width: max(label.preferred-width + 14px, 44px);
    height: 45px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-description: root.attention ? @tr("needs attention") : "";
    accessible-action-default => { root.clicked(); }
    Rectangle {
        border-radius: 6px;
        background: root.selected ? (Theme.dark ? #ffffff14 : #00000012) : transparent;
    }
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 0px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 23px;
                height: 23px;
                colorize: root.selected ? Theme.accent : label.color;
                if root.attention: Rectangle {
                    x: parent.width - 3px;
                    y: -1px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.partial;
                }
            }
        }
        label := Text {
            text: root.text;
            // Systemschrift-Alias verlor in Slint Umlaute („Über“ → „Uber“); Helvetica Neue gibt es auf jedem Mac
            font-family: "Helvetica Neue";
            font-size: 12px;
            horizontal-alignment: center;
            // dunkel 55 % Weiß (4.8:1), hell 65 % Schwarz (5.9:1 auf #f0f0f0; 50 % wären nur 3.9:1)
            color: root.selected ? Theme.accent : Theme.dark ? #ffffff8c : #000000a6;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Avid-Projekte (Reiter „Projekte“): Rust füllt diesen Zustand, die Seite zeigt ihn je Schritt (view)
export global Projects {
    // 0 nichts gelesen, 1 liest Bins, 2 Ergebnis da
    in property <int> step;
    // Schritt in der Seitenleiste: 0 Projekte wählen, 1 Fehlende Medien, 2 AMA-Clips, 3 Anfordern
    in-out property <int> view;
    in property <string> folder;
    in property <[DriveRow]> projects;
    in property <int> selected-count;
    in property <string> error;
    in property <string> work-text;
    in property <float> work-value;
    in property <int> missing;
    in property <int> unmanaged;
    in property <int> no-media;
    in property <int> bins;
    in property <int> clips;
    in property <int> failed;
    in property <int> unknown;
    in property <string> skipped;
    in property <int> renders;
    in property <int> relink;
    in property <int> ama;
    in property <int> ama-covered;
    in property <[MissingRow]> rows;
    in property <[MissingRow]> ama-rows;
    callback choose-folder();
    callback toggle(int);
    callback scan();
    callback save-list();
    callback save-request();
    callback toggle-group(int);
    callback toggle-ama(int);
    // eigenes, größeres Fenster: 0 fehlende Medien, 1 AMA-Clips
    callback show-media(int);
}

// Seitenkopf wie im Entwurf: Titel links, Knöpfe der Seite rechts
component PageHead inherits HorizontalLayout {
    in property <string> title;
    spacing: 8px;
    Text {
        text: root.title;
        horizontal-stretch: 1;
        vertical-alignment: center;
        overflow: elide;
        font-size: 14px;
        font-weight: 600;
        color: Theme.text;
    }
    @children
}

// Ablauf eines Pflegen-Werkzeugs: Teile mit „──“ dazwischen, der aktuelle fett (Farbe allein trägt nichts)
component FlowStrip inherits HorizontalLayout {
    in property <[string]> parts;
    in property <int> current;
    spacing: 6px;
    alignment: start;
    for p[i] in root.parts: HorizontalLayout {
        spacing: 6px;
        if i > 0: Text { text: "──"; font-size: 11px; color: Theme.faint; }
        Text {
            text: p;
            font-size: 11px;
            font-weight: i == root.current ? 700 : 400;
            color: i == root.current ? Theme.text : Theme.faint;
            accessible-description: i == root.current ? @tr("current step") : "";
        }
    }
}

component ProjectsPane inherits VerticalLayout {
    spacing: Metrics.spacing;
    property <int> dot-count;
    Timer {
        interval: 400ms;
        running: Projects.step == 1;
        triggered => { root.dot-count = Math.mod(root.dot-count + 1, 4); }
    }

    // ── Projekte wählen ──
    if Projects.view == 0 && Projects.step != 1: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: @tr("Choose projects");
            CheckButton {
                text: @tr("Choose folder…");
                clicked => { Projects.choose-folder(); }
            }
            CheckButton {
                text: @tr("Scan");
                primary: true;
                enabled: Projects.selected-count > 0;
                clicked => { Projects.scan(); }
            }
        }
        Text {
            text: Projects.folder == "" ? @tr("No folder chosen") : Projects.folder;
            overflow: elide;
            font-size: 12px;
            color: Projects.folder == "" ? Theme.faint : Theme.muted;
        }
        if Projects.folder != "" && Projects.projects.length == 0: Text {
            text: @tr("No Avid projects in this folder.");
            color: Theme.muted;
        }
        if Projects.projects.length > 0: ScrollBox {
            limit: 300px;
            spacing: 2px;
            for p[i] in Projects.projects: HorizontalLayout {
                height: 26px;
                spacing: 10px;
                Text {
                    text: p.name;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                    color: p.selected ? Theme.text : Theme.muted;
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        on: p.selected;
                        label: p.name;
                        toggled => { Projects.toggle(i); }
                    }
                }
            }
        }
        Para {
            text: @tr("Reads every bin of the switched-on projects and lists the media files their clips, subclips and sequences need that are on none of the connected drives. Nothing is changed.");
        }
        StatusLine {
            text: Projects.error;
            color: Theme.error;
        }
    }

    // ── Bins werden gelesen ──
    if Projects.step == 1: Section {
        title: @tr("READING BINS");
        ProgressBar { value: Projects.work-value; }
        StatusLine {
            text: Projects.work-text;
            color: Theme.muted;
        }
        Text {
            text: @tr("Please wait{}", root.dot-count == 1 ? ".  " : root.dot-count == 2 ? ".. " : root.dot-count == 3 ? "..." : "   ");
            font-size: 12px;
            color: Theme.faint;
        }
    }

    // ── Fehlende Medien ──
    if Projects.view == 1 && Projects.step == 2: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: Projects.missing == 0 ? @tr("All media files are on the drives") : @tr("{n} media file missing" | "{n} media files missing" % Projects.missing);
            CheckButton {
                text: @tr("Save list…");
                clicked => { Projects.save-list(); }
            }
        }
        VerticalLayout {
            spacing: 10px;
            Text {
                text: @tr("{} bins, {} clips checked", Projects.bins, Projects.clips);
                font-size: 12px;
                color: Theme.muted;
            }
            if Projects.unknown > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} MXF file on the drives could not be identified: it is in no Avid database and its header is unreadable – clips using it are listed as missing. The file may be damaged or still being written." | "{n} MXF files on the drives could not be identified: they are in no Avid database and their headers are unreadable – clips using them are listed as missing. The files may be damaged or still being written." % Projects.unknown);
                color: Theme.warning;
            }
            if Projects.skipped != "": Para {
                width: Metrics.content-width - 12px;
                text: @tr("These drives did not answer and were skipped – media on them count as missing: {}. If macOS asks whether MediaFiles Check may access files on a volume, allow it and scan again.", Projects.skipped);
                color: Theme.warning;
            }
            if Projects.failed > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} bin could not be read – see the saved list." | "{n} bins could not be read – see the saved list." % Projects.failed);
                color: Theme.warning;
            }
            if Projects.renders > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} render file is missing too – not requested, Media Composer renders it again." | "{n} render files are missing too – not requested, Media Composer renders them again." % Projects.renders);
            }
            if Projects.relink > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} missing file is on the drives as another media file of the same source (camera clip or tape) – the clip only lost its link: relink it in Media Composer. Not requested." | "{n} missing files are on the drives as other media files of the same source (camera clip or tape) – the clips only lost their link: relink them in Media Composer. Not requested." % Projects.relink);
            }
            if Projects.ama > 0: HorizontalLayout {
                spacing: 10px;
                Text {
                    text: @tr("{n} AMA-linked file – not requested." | "{n} AMA-linked files – not requested." % Projects.ama);
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-size: 12px;
                    color: Theme.muted;
                }
                CheckButton {
                    text: @tr("Show AMA clips");
                    clicked => { Projects.view = 2; }
                }
            }
            if Projects.ama-covered > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} AMA-linked file has a master clip of the same name with its media on the drives – left out." | "{n} AMA-linked files have a master clip of the same name with its media on the drives – left out." % Projects.ama-covered);
            }
            if Projects.no-media > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} reference without a media file left out – e.g. camera sound that was never imported; Media Composer shows such clips online." | "{n} references without a media file left out – e.g. camera sound that was never imported; Media Composer shows such clips online." % Projects.no-media);
            }
            if Projects.unmanaged > 0: Para {
                width: Metrics.content-width - 12px;
                text: @tr("{n} of the missing files has no Avid media reference – e.g. imported via AAF. the exchange only finds it if the other system has it in Avid MediaFiles." | "{n} of the missing files have no Avid media reference – e.g. imported via AAF. the exchange only finds them if the other system has them in Avid MediaFiles." % Projects.unmanaged);
            }
                }
        if Projects.rows.length > 0: HorizontalLayout {
            alignment: start;
            CheckButton {
                text: @tr("Show media…");
                primary: true;
                clicked => { Projects.show-media(0); }
            }
        }
        StatusLine {
            text: Projects.error;
            color: Theme.error;
        }
    }

    // ── AMA-Clips ──
    if Projects.view == 2 && Projects.step == 2: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: @tr("{n} AMA-linked file" | "{n} AMA-linked files" % Projects.ama);
        }
        Para {
            text: @tr("Where the AMA-linked clips are used. Click a clip to see its master clips, subclips and sequences. AMA files are not requested.");
        }
        if Projects.ama-rows.length > 0: HorizontalLayout {
            alignment: start;
            CheckButton {
                text: @tr("Show clips…");
                primary: true;
                clicked => { Projects.show-media(1); }
            }
        }
    }

    // ── Anfordern ──
    if Projects.view == 3 && Projects.step == 2: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: @tr("Request missing media");
            CheckButton {
                text: @tr("Save request…");
                primary: true;
                enabled: Projects.missing > 0;
                clicked => { Projects.save-request(); }
            }
        }
        Para {
            text: Projects.missing == 0 ? @tr("Nothing to request – all media files are on the drives.")
                : @tr("{n} media file will be requested." | "{n} media files will be requested." % Projects.missing)
                    + (Projects.relink > 0 ? " " + @tr("Files to relink are not part of it.") : "");
            color: Theme.text;
        }
        if Projects.missing > 0: Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                for t[i] in [
                    @tr("Send the request file to the system that has the media (mail, USB stick)."),
                    @tr("There: Exchange › Compare, open the file, then Collect."),
                    @tr("Here: Exchange › Import the delivery."),
                ]: HorizontalLayout {
                    spacing: 10px;
                    Text { text: i + 1; font-size: 12px; color: Theme.faint; }
                    Text { text: t; width: Metrics.content-width - 60px; wrap: word-wrap; font-size: 12px; color: Theme.text; }
                }
            }
        }
        StatusLine {
            text: Projects.error;
            color: Theme.error;
        }
    }
}

// Austausch (früher MediaFiles Ferry): Rust füllt diesen Zustand, die Seite zeigt ihn je Schritt (view)
export struct VolumeRow {
    name: string,
    files: string,
    online: bool,
    selected: bool,
}
// Zuordnung eines Laufwerks: options[0] = „Wählen…“ (noch offen)
export struct MapRow {
    name: string,
    options: [string],
    selected: int,
}
// Ordner auf beiden Seiten: -1 offen, 0 zusammenführen, 1 umbenennen
export struct ChoiceRow {
    name: string,
    choice: int,
}

export global Exchange {
    // Schritt in der Seitenleiste: 0 Scannen, 1 Vergleichen, 2 Sammeln, 3 Importieren
    in-out property <int> view;
    in property <string> system-name;
    in property <[VolumeRow]> volumes;
    in property <int> selected-count;
    in property <int> minutes-since-scan: -1;
    in property <bool> scanning;
    in property <string> progress;
    in property <int> warnings;
    in property <string> error;
    in property <bool> has-manifest;
    // Vergleichen
    in property <bool> has-compare;
    in property <string> remote-name;
    in property <string> remote-date;
    in property <bool> is-request;
    in property <[MapRow]> maps;
    in property <[ChoiceRow]> collisions;
    in property <int> copy-files;
    in property <string> copy-size;
    in property <[string]> tasks;
    in property <bool> can-collect;
    // Fortschritt (busy): 0 sammeln, 1 prüfen, 2 einspielen
    in property <bool> busy;
    in property <int> work-kind;
    in property <string> work-text;
    in property <float> work-value;
    // Ergebnis: -1 keins, 0 gesammelt, 1 gesammelt mit Fehlern, 2 eingespielt, 3 eingespielt mit Problemen, 4 Prüfung fehlgeschlagen
    in property <int> result-kind: -1;
    in property <string> result-path;
    in property <[string]> result-problems;
    in property <[string]> result-tasks;
    // Lieferung einspielen
    in property <bool> has-delivery;
    in property <string> delivery-from;
    in property <int> delivery-files;
    in property <string> delivery-size;
    in property <[MapRow]> delivery-maps;
    in property <bool> can-import;
    callback scan();
    callback toggle-volume(int);
    callback save-manifest();
    callback open-manifest();
    callback map-changed(int, int);
    callback choice-changed(int, int);
    callback collect();
    callback choose-delivery();
    callback delivery-map-changed(int, int);
    callback start-import();
    callback show-result();
    callback close-result();
    // Rust intern: Laufwerksliste neu aufbauen (nach dem Scannen)
    callback rescanned();
}

component MapList inherits VerticalLayout {
    in property <[MapRow]> rows;
    callback changed(int, int);
    spacing: 8px;
    for r[i] in root.rows: HorizontalLayout {
        spacing: 10px;
        Text {
            text: r.name;
            width: 180px;
            overflow: elide;
            vertical-alignment: center;
            color: Theme.text;
        }
        Text {
            text: "→";
            vertical-alignment: center;
            color: Theme.muted;
        }
        Dropdown {
            items: r.options;
            current: r.selected;
            selected(index) => { root.changed(i, index); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

component LineList inherits ScrollBox {
    in property <[string]> lines;
    in property <color> text-color: Theme.text;
    limit: 200px;
    spacing: 6px;
    for l in root.lines: Text {
        width: Metrics.content-width - 24px;
        text: l;
        font-size: 12px;
        wrap: word-wrap;
        color: root.text-color;
    }
}

component ExchangePane inherits VerticalLayout {
    spacing: Metrics.spacing;
    property <int> dot-count;
    property <string> dots: root.dot-count == 1 ? ".  " : root.dot-count == 2 ? ".. " : root.dot-count == 3 ? "..." : "   ";
    Timer {
        interval: 400ms;
        running: Exchange.scanning || Exchange.busy;
        triggered => { root.dot-count = Math.mod(root.dot-count + 1, 4); }
    }
    property <int> hours: Exchange.minutes-since-scan / 60;
    property <int> days: root.hours / 24;
    property <string> scan-status: Exchange.scanning ? @tr("Scanning{} {}", root.dots, Exchange.progress)
        : Exchange.minutes-since-scan < 0 ? @tr("Not scanned yet")
        : Exchange.minutes-since-scan < 1 ? @tr("Last scan: just now")
        : Exchange.minutes-since-scan < 60 ? @tr("Last scan: {n} minute ago" | "Last scan: {n} minutes ago" % Exchange.minutes-since-scan)
        : root.hours < 24 ? @tr("Last scan: {n} hour ago" | "Last scan: {n} hours ago" % root.hours)
        : @tr("Last scan: {n} day ago" | "Last scan: {n} days ago" % root.days);
    property <string> work-title: Exchange.work-kind == 0 ? @tr("Collecting for {}", Exchange.remote-name)
        : Exchange.work-kind == 1 ? @tr("Verifying the delivery") : @tr("Importing the delivery");
    property <bool> result-ok: Exchange.result-kind == 0 || Exchange.result-kind == 2;
    property <string> result-title: Exchange.result-kind == 0 ? @tr("Delivery ready")
        : Exchange.result-kind == 1 ? @tr("Delivery ready – some files could not be copied")
        : Exchange.result-kind == 2 ? @tr("Delivery imported")
        : Exchange.result-kind == 3 ? @tr("Delivery imported with problems") : @tr("Delivery is incomplete or damaged – nothing was imported");
    property <string> result-hint: Exchange.result-kind <= 1 ? @tr("Give this folder to {} (e.g. on a drive); there it is imported with Exchange › Import. Instructions for importing by hand are inside.", Exchange.remote-name)
        : Exchange.result-kind == 4 ? @tr("Ask {} for a new delivery or copy the folder again.", Exchange.delivery-from)
        : @tr("Scan again so that the manifest is up to date.");
    // Ergebnis gehört zu Sammeln (0, 1) oder Importieren (2–4)
    property <bool> show-result: Exchange.result-kind >= 0 && !Exchange.busy && (Exchange.result-kind <= 1 ? Exchange.view == 2 : Exchange.view == 3);
    property <bool> show-busy: Exchange.busy && (Exchange.work-kind == 0 ? Exchange.view == 2 : Exchange.view == 3);

    // ── Scannen ──
    if Exchange.view == 0: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: @tr("Scan this system");
            CheckButton {
                text: @tr("Save manifest…");
                enabled: Exchange.has-manifest && !Exchange.scanning;
                clicked => { Exchange.save-manifest(); }
            }
            CheckButton {
                text: @tr("Scan");
                primary: true;
                enabled: !Exchange.scanning && Exchange.selected-count > 0;
                clicked => { Exchange.scan(); }
            }
        }
        Para {
            text: @tr("Checksums are remembered – only new or changed files are read. The manifest lists what this system has; the other system opens it under Exchange › Compare.");
        }
        Section {
            title: Exchange.system-name;
            if Exchange.volumes.length == 0: Text {
                text: @tr("No drive with “Avid MediaFiles/MXF” found.");
                overflow: elide;
                color: Theme.muted;
            }
            if Exchange.volumes.length == 0: Para {
                text: @tr("Connect a drive with Avid media. If macOS asks whether MediaFiles Check may access files on removable or network volumes, allow it.");
                color: Theme.faint;
            }
            if Exchange.volumes.length > 0: ScrollBox {
                limit: 6 * 22px + 5 * 10px;
                spacing: 10px;
                for v[i] in Exchange.volumes: HorizontalLayout {
                    spacing: 10px;
                    height: 22px;
                    Dot { color: v.online ? Theme.online : Theme.line; }
                    Text {
                        text: v.name;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                        color: v.online && v.selected ? Theme.text : Theme.muted;
                    }
                    Text {
                        text: !v.online ? @tr("not connected") : v.files == "" ? @tr("not scanned yet") : @tr("{} files", v.files);
                        font-size: 12px;
                        vertical-alignment: center;
                        color: v.files == "" ? Theme.faint : Theme.muted;
                    }
                    VerticalLayout {
                        alignment: center;
                        width: 34px;
                        if v.online: Switch {
                            on: v.selected;
                            label: v.name;
                            toggled => { Exchange.toggle-volume(i); }
                        }
                    }
                }
            }
        }
        StatusLine {
            text: root.scan-status;
            color: Theme.muted;
        }
        if Exchange.error != "" || (Exchange.warnings > 0 && !Exchange.scanning): Para {
            text: Exchange.error != "" ? Exchange.error : @tr("{n} warning" | "{n} warnings" % Exchange.warnings);
            color: Exchange.error != "" ? Theme.error : Theme.warning;
        }
        Para {
            text: @tr("The switches apply to Check › Drives too.");
            color: Theme.faint;
        }
    }

    // ── Vergleichen ──
    if Exchange.view == 1: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: !Exchange.has-compare ? @tr("Compare with another system")
                : Exchange.is-request ? @tr("Request from {}", Exchange.remote-name) : @tr("Compare with {}", Exchange.remote-name);
            CheckButton {
                text: Exchange.has-compare ? @tr("Other manifest…") : @tr("Open manifest…");
                primary: !Exchange.has-compare;
                enabled: Exchange.has-manifest && !Exchange.scanning;
                clicked => { Exchange.open-manifest(); }
            }
            if Exchange.has-compare: CheckButton {
                text: @tr("Collect…");
                primary: true;
                enabled: Exchange.can-collect && Exchange.copy-files > 0 && !Exchange.busy;
                clicked => { Exchange.collect(); }
            }
        }
        if !Exchange.has-compare: Para {
            text: Exchange.has-manifest ? @tr("Open the manifest of the other system, or a request saved under Projects › Request.") : @tr("Scan this system first (Exchange › Scan).");
        }
        if Exchange.has-compare: Text {
            text: Exchange.is-request ? @tr("Request from {}", Exchange.remote-date) : @tr("Manifest from {}", Exchange.remote-date);
            font-size: 12px;
            color: Theme.muted;
        }
        if Exchange.has-compare && Exchange.maps.length > 0: Section {
            title: @tr("ASSIGN DRIVES");
            Para { text: @tr("These drives have no drive with the same name on the other system."); }
            MapList {
                rows: Exchange.maps;
                changed(i, v) => { Exchange.map-changed(i, v); }
            }
        }
        if Exchange.has-compare && Exchange.collisions.length > 0: Section {
            title: @tr("FOLDERS ON BOTH SIDES");
            Para { text: @tr("These folders exist on both systems with files of their own."); }
            for c[i] in Exchange.collisions: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: c.name;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                CheckButton {
                    text: @tr("Merge");
                    small: true;
                    primary: c.choice == 0;
                    clicked => { Exchange.choice-changed(i, 0); }
                }
                CheckButton {
                    text: @tr("Rename");
                    small: true;
                    primary: c.choice == 1;
                    clicked => { Exchange.choice-changed(i, 1); }
                }
            }
            Para {
                text: @tr("Merge: same folder, the database must be rebuilt. Rename: new folder with a unique name.");
                font-size: 11px;
                color: Theme.faint;
            }
        }
        if Exchange.has-compare: Section {
            title: @tr("FOR {}", Exchange.remote-name);
            Para {
                text: Exchange.copy-files == 0 ? @tr("Nothing to collect – the other system has everything.")
                    : @tr("{n} file to collect ({})" | "{n} files to collect ({})" % Exchange.copy-files, Exchange.copy-size);
                font-size: 13px;
                color: Theme.text;
            }
        }
        if Exchange.has-compare && Exchange.tasks.length > 0: Section {
            title: @tr("TASKS");
            LineList { lines: Exchange.tasks; }
        }
        if Exchange.error != "": Para {
            text: Exchange.error;
            color: Theme.error;
        }
    }

    // ── Sammeln / Importieren: Fortschritt ──
    if root.show-busy: VerticalLayout {
        spacing: 14px;
        PageHead { title: root.work-title; }
        ProgressBar { value: Exchange.work-value; }
        StatusLine {
            text: Exchange.work-text;
            color: Theme.muted;
        }
        Text {
            text: @tr("Please wait{}", root.dots);
            font-size: 12px;
            color: Theme.faint;
        }
        Para {
            text: Exchange.work-kind == 0 ? @tr("Every file is compared with its checksum after copying. Interrupted? Collect again continues where it stopped.") : @tr("Adds files only and never overwrites a media file. Replaced databases go to Ferry-Backup.");
        }
    }

    // ── Sammeln / Importieren: Ergebnis ──
    if root.show-result: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: root.result-title;
            if Exchange.result-path != "": CheckButton {
                text: @tr("Show in Finder");
                clicked => { Exchange.show-result(); }
            }
            CheckButton {
                text: @tr("Done");
                primary: true;
                clicked => { Exchange.close-result(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Dot { color: root.result-ok ? Theme.online : Theme.error; }
            Para {
                width: Metrics.content-width - 30px;
                text: root.result-hint;
                color: Theme.text;
            }
        }
        if Exchange.result-path != "": Para {
            text: Exchange.result-path;
            font-size: 11px;
            color: Theme.faint;
        }
        if Exchange.result-problems.length > 0: Section {
            title: @tr("PROBLEMS");
            LineList {
                lines: Exchange.result-problems;
                text-color: Theme.error;
            }
        }
        if Exchange.result-tasks.length > 0: Section {
            title: @tr("TASKS");
            LineList { lines: Exchange.result-tasks; }
        }
    }

    // ── Sammeln: noch nichts ──
    if Exchange.view == 2 && !root.show-busy && !root.show-result: VerticalLayout {
        spacing: 14px;
        PageHead { title: @tr("Collect a delivery"); }
        Para {
            text: Exchange.has-compare ? @tr("{n} file to collect ({})" | "{n} files to collect ({})" % Exchange.copy-files, Exchange.copy-size) + " " + @tr("Collect… is under Exchange › Compare.")
                : @tr("Compare with the other system first: Exchange › Compare. Collecting copies the files it is missing, with checksums, into a delivery folder.");
        }
    }

    // ── Importieren ──
    if Exchange.view == 3 && !root.show-busy && !root.show-result: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: Exchange.has-delivery ? @tr("Delivery from {}", Exchange.delivery-from) : @tr("Import a delivery");
            CheckButton {
                text: @tr("Choose delivery…");
                primary: !Exchange.has-delivery;
                enabled: !Exchange.busy;
                clicked => { Exchange.choose-delivery(); }
            }
            if Exchange.has-delivery: CheckButton {
                text: @tr("Verify & import");
                primary: true;
                enabled: Exchange.can-import && !Exchange.busy;
                clicked => { Exchange.start-import(); }
            }
        }
        if !Exchange.has-delivery: Para {
            text: @tr("Choose the delivery folder another system collected for this one. Everything is verified first; only a complete delivery is imported.");
        }
        if Exchange.has-delivery: Text {
            text: @tr("{n} file ({})" | "{n} files ({})" % Exchange.delivery-files, Exchange.delivery-size);
            font-size: 12px;
            color: Theme.muted;
        }
        if Exchange.has-delivery: Section {
            title: @tr("ASSIGN DRIVES");
            MapList {
                rows: Exchange.delivery-maps;
                changed(i, v) => { Exchange.delivery-map-changed(i, v); }
            }
        }
        if Exchange.has-delivery: Para {
            text: @tr("Quit Media Composer before importing. Every file is verified first, and only a complete delivery is imported. A media file is never overwritten.");
            color: Theme.warning;
        }
        if Exchange.error != "": Para {
            text: Exchange.error;
            color: Theme.error;
        }
    }
}

// Aufgaben: alles, was Handarbeit braucht (aus Lieferungen gespeichert, Datenbank-Runden und Umbenennungen live)
export struct TaskRow {
    text: string,
    source: string,
    // Knopf für den nächsten Schritt ("" = keiner)
    action: string,
    // gespeicherte Aufgabe (abhakbar) oder live aus dem Zustand der App
    stored: bool,
    // für diesen Schnittplatz (sonst geht sie mit einer Lieferung an den anderen)
    mine: bool,
}

export global Tasks {
    // 0 Offen, 1 Von Hand importieren, 2 Erledigt
    in-out property <int> view;
    in property <[TaskRow]> open;
    in property <[TaskRow]> done;
    callback action(int);
    callback finish(int);
    callback reopen(int);
    callback clear-done();
    // Rust intern: Liste neu aufbauen
    callback reload();
}

component TaskList inherits ScrollBox {
    in property <[TaskRow]> rows;
    in property <bool> finished;
    limit: 380px;
    spacing: 0px;
    for t[i] in root.rows: VerticalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Dot { color: root.finished ? Theme.online : t.mine ? Theme.warning : Theme.line; }
            Text {
                text: t.text;
                width: Metrics.content-width - 44px;
                wrap: word-wrap;
                font-size: 12px;
                color: root.finished ? Theme.muted : Theme.text;
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            spacing: 8px;
            Text {
                text: t.source;
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-size: 11px;
                overflow: elide;
                color: Theme.faint;
            }
            if t.action != "" && !root.finished: CheckButton {
                text: t.action;
                small: true;
                clicked => { Tasks.action(i); }
            }
            if t.stored && !root.finished: CheckButton {
                text: @tr("Done");
                small: true;
                clicked => { Tasks.finish(i); }
            }
            if root.finished: CheckButton {
                text: @tr("Reopen");
                small: true;
                clicked => { Tasks.reopen(i); }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
    }
}

component TasksPane inherits VerticalLayout {
    spacing: 14px;
    if Tasks.view == 0: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: Tasks.open.length == 0 ? @tr("Nothing to do by hand right now.") : @tr("{n} open task" | "{n} open tasks" % Tasks.open.length);
        }
        if Tasks.open.length > 0: TaskList { rows: Tasks.open; }
        Para {
            text: @tr("Tasks come from deliveries (Exchange) and from Maintain. A yellow dot is for this system; the others go with a delivery to the other system.");
            color: Theme.faint;
        }
    }
    if Tasks.view == 1: VerticalLayout {
        spacing: 10px;
        PageHead { title: @tr("Import a delivery by hand"); }
        for t[i] in [
            @tr("Quit Media Composer."),
            @tr("Every folder of the delivery is named <drive>/<folder>. On that drive open “Avid MediaFiles/MXF/<folder>” (create it if it is missing)."),
            @tr("Copy only the contents of the delivery folder into it – never drag the whole folder onto an existing folder: the Finder would replace it with all its media files."),
            @tr("If you are asked to replace .mxf files: don't – cancel and check."),
            @tr("Replace msmFMID.pmr and msmMMOB.mdb only in the folders listed in the delivery's Tasks.txt."),
        ]: HorizontalLayout {
            spacing: 10px;
            Text { text: i + 1; font-size: 12px; color: Theme.faint; }
            Text {
                text: t;
                width: Metrics.content-width - 40px;
                wrap: word-wrap;
                font-size: 12px;
                font-weight: i == 2 ? 700 : 400;
                color: i == 2 ? Theme.warning : Theme.text;
            }
        }
        Para {
            text: @tr("Easier and safe: Exchange › Import verifies everything and imports only a complete delivery.");
            color: Theme.faint;
        }
    }
    if Tasks.view == 2: VerticalLayout {
        spacing: 14px;
        PageHead {
            title: @tr("Completed");
            if Tasks.done.length > 0: CheckButton {
                text: @tr("Clear list");
                clicked => { Tasks.clear-done(); }
            }
        }
        if Tasks.done.length == 0: Para { text: @tr("Nothing completed yet."); }
        if Tasks.done.length > 0: TaskList { rows: Tasks.done; finished: true; }
    }
}

// Seiten des Hauptfensters; jede gehört zu einem Reiter (tab-of) und einem Schritt der Seitenleiste (step-of)
export enum Page { home, working, result, rename, question, notice, rebalance, rebalanced, runs, askname, dups, dupsdone,
    maintain, rebalstart, dupsstart, exchange, projects, tasks }

// Schritt in der Seitenleiste: Name und darunter klein sein Stand (Variante C: keine Ziffern, kein Häkchen)
export struct SideStep {
    name: string,
    status: string,
    enabled: bool,
}

component SideItem {
    in property <SideStep> step;
    in property <bool> selected;
    callback clicked;
    accessible-role: tab;
    accessible-label: root.step.name;
    accessible-description: root.step.status;
    accessible-checked: root.selected;
    accessible-enabled: root.step.enabled;
    accessible-action-default => { if root.step.enabled { root.clicked(); } }
    Rectangle {
        border-radius: 6px;
        background: root.selected ? Theme.selection : touch.has-hover && root.step.enabled ? Theme.selection.with-alpha(0.5) : transparent;
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 1px;
        Text {
            text: root.step.name;
            font-size: 12px;
            overflow: elide;
            color: root.selected ? Theme.text : root.step.enabled ? Theme.muted : Theme.disabled;
        }
        if root.step.status != "": Text {
            text: root.step.status;
            font-size: 10px;
            overflow: elide;
            color: Theme.faint;
        }
    }
    touch := TouchArea {
        enabled: root.step.enabled;
        mouse-cursor: root.step.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Duplikate: eine Kopie (Laufwerk: Ordner[ · Name]), keep = diese bleibt
export struct DupCopy {
    place: string,
    keep: bool,
}

// Duplikate: eine Mediendatei mit ihren Kopien; selected = Kopien zur Seite legen; blocked = nicht wählbar
export struct DupGroup {
    title: string,
    detail: string,
    note: string,
    selected: bool,
    blocked: bool,
    copies: [DupCopy],
}

// frühere Rebalancings: Text (Rust, übersetzt), ob „Starten“ (Datenbanken) schon gemacht ist
export struct RunRow {
    text: string,
    db-done: bool,
}

// Rebalancing: ein Ordner über der Grenze, title = Laufwerk/Ordner, detail = was entsteht (Rust, übersetzt)
export struct RebalRow {
    title: string,
    detail: string,
    // Hinweis in Warnfarbe (Media-Composer-Ordner, gesperrt), leer = keiner
    note: string,
    selected: bool,
    // ein Ordner der Gruppe ist gerade für Media Composer umbenannt: nicht wählbar
    blocked: bool,
}

export component AppWindow inherits CheckWindow {
    title: root.tab == 0 ? @tr("Exchange") : root.tab == 1 ? @tr("Check") : root.tab == 2 ? @tr("Projects") : root.tab == 3 ? @tr("Maintain") : @tr("Tasks");
    width: 800px;
    // nie höher als der Bildschirm (Rust: nutzbare Höhe minus Titelleiste); längere Seiten scrollen
    in property <length> screen-height: 100000px;
    // feste Größe für alle Reiter (der Nutzer wollte kein Springen); längere Seiten scrollen im Inhalt
    height: min(600px, root.screen-height);
    // wie das Einstellungsfenster: Reiterleiste in der Farbe der Titelleiste (heller, solange das Fenster aktiv ist)
    in property <bool> active: true;

    in property <string> language: "en";
    in-out property <Page> page: Page.home;
    // Reiter: 0 Austausch, 1 Prüfen, 2 Projekte, 3 Pflegen, 4 Aufgaben; jeder merkt sich seine Seite
    in-out property <int> tab: 1;
    property <int> step;
    property <Page> page0: Page.exchange;
    property <Page> page1: Page.home;
    property <Page> page2: Page.projects;
    property <Page> page3: Page.maintain;
    property <Page> page4: Page.tasks;
    in-out property <bool> has-result;
    // erster Start: Überblick über die Reiter (Rust merkt sich das Schließen in welcome-seen)
    in-out property <bool> show-welcome;
    callback welcome-done();

    // -1: Seite gehört zu keinem bestimmten Reiter (Fortschritt, Hinweis) – sie bleibt im aktuellen
    pure function tab-of(p: Page) -> int {
        if p == Page.exchange { return 0; }
        if p == Page.home || p == Page.result { return 1; }
        if p == Page.projects { return 2; }
        if p == Page.tasks { return 4; }
        if p == Page.working || p == Page.notice { return -1; }
        return 3;
    }
    pure function step-of(p: Page) -> int {
        if p == Page.result { return 1; }
        if p == Page.rebalstart || p == Page.rebalance || p == Page.askname || p == Page.rebalanced { return 1; }
        if p == Page.dupsstart || p == Page.dups || p == Page.dupsdone { return 2; }
        if p == Page.runs { return 3; }
        if p == Page.working || p == Page.notice { return -1; }
        return 0;
    }
    // erste Seite eines Schritts
    pure function start-of(t: int, s: int) -> Page {
        if t == 0 { return Page.exchange; }
        if t == 1 { return s == 1 && root.has-result ? Page.result : Page.home; }
        if t == 2 { return Page.projects; }
        if t == 4 { return Page.tasks; }
        return s == 1 ? Page.rebalstart : s == 2 ? Page.dupsstart : s == 3 ? Page.runs : Page.maintain;
    }
    // Rust: „zurück zum Anfang“ = Anfang des Schritts, in dem man gerade ist
    public function home() {
        // Prüfen: zurück zu den Laufwerken (der Schritt „Ergebnis“ würde wieder das Ergebnis zeigen)
        root.page = root.tab == 1 ? Page.home : root.start-of(root.tab, root.step);
    }
    function select-tab(t: int) {
        root.tab = t;
        root.page = t == 0 ? root.page0 : t == 1 ? root.page1 : t == 2 ? root.page2 : t == 3 ? root.page3 : root.page4;
        if root.step-of(root.page) >= 0 { root.step = root.step-of(root.page); }
    }
    changed page => {
        page-flick.content-y = 0;
        if root.tab-of(root.page) >= 0 && root.tab-of(root.page) != root.tab { root.tab = root.tab-of(root.page); }
        if root.step-of(root.page) >= 0 { root.step = root.step-of(root.page); }
        if root.page == Page.result { root.has-result = true; }
        if root.tab == 0 { root.page0 = root.page; }
        if root.tab == 1 { root.page1 = root.page; }
        if root.tab == 2 { root.page2 = root.page; }
        if root.tab == 3 { root.page3 = root.page; }
        if root.tab == 4 { root.page4 = root.page; }
    }
    property <int> runs-open: root.rebalance-pending + root.dup-pending;
    property <[SideStep]> steps: root.tab == 0 ? [
            { name: @tr("Scan"), status: Exchange.scanning ? @tr("scanning…") : Exchange.has-manifest ? @tr("scanned") : "", enabled: true },
            { name: @tr("Compare"), status: Exchange.has-compare ? Exchange.remote-name : "", enabled: true },
            { name: @tr("Collect"), status: Exchange.busy && Exchange.work-kind == 0 ? @tr("collecting…") : Exchange.result-kind == 0 ? @tr("delivery ready") : "", enabled: true },
            { name: @tr("Import"), status: Exchange.busy && Exchange.work-kind > 0 ? @tr("importing…") : Exchange.has-delivery ? Exchange.delivery-from : "", enabled: true },
        ] : root.tab == 1 ? [
            { name: @tr("Drives"), status: @tr("{} of {} on", root.selected-count, root.drives.length), enabled: true },
            { name: @tr("Result"), status: !root.has-result ? "" : root.bad-folders == 0 ? @tr("all match") : @tr("{n} folder differs" | "{n} folders differ" % root.bad-folders), enabled: root.has-result },
        ] : root.tab == 2 ? [
            { name: @tr("Choose projects"), status: Projects.projects.length == 0 ? "" : @tr("{} of {} on", Projects.selected-count, Projects.projects.length), enabled: true },
            { name: @tr("Missing media"), status: Projects.step != 2 ? "" : @tr("{n} file" | "{n} files" % Projects.missing), enabled: Projects.step == 2 },
            { name: @tr("AMA clips"), status: Projects.step != 2 ? "" : @tr("{n} file" | "{n} files" % Projects.ama), enabled: Projects.step == 2 },
            { name: @tr("Request"), status: "", enabled: Projects.step == 2 && Projects.missing > 0 },
        ] : root.tab == 3 ? [
            { name: @tr("Rename"), status: root.renamed.length == 0 ? "" : @tr("{n} folder renamed" | "{n} folders renamed" % root.renamed.length), enabled: true },
            { name: @tr("Rebalancing"), status: root.rebalance-pending > 0 ? @tr("databases pending") : "", enabled: true },
            { name: @tr("Duplicates"), status: root.dup-pending > 0 ? @tr("databases pending") : "", enabled: true },
            { name: @tr("History"), status: root.rebalanced.length + root.dup-runs.length == 0 ? "" : @tr("{n} run" | "{n} runs" % (root.rebalanced.length + root.dup-runs.length)), enabled: true },
        ] : [
            { name: @tr("Open"), status: Tasks.open.length == 0 ? "" : Tasks.open.length, enabled: true },
            { name: @tr("Import by hand"), status: @tr("instructions"), enabled: true },
            { name: @tr("Completed"), status: Tasks.done.length == 0 ? "" : Tasks.done.length, enabled: true },
        ];
    in property <[DriveRow]> drives;
    in property <int> selected-count;
    in property <string> error;
    // Fortschritt
    in property <string> work-text;
    in property <float> work-value;
    // Ergebnis
    in property <int> checked-folders;
    in property <int> bad-folders;
    in property <[ReportRow]> rows;
    // Umbenennen für Media Composer
    in property <int> rename-count;
    in property <[RenameRow]> rename-rows;
    in property <[RenamedRow]> renamed;
    in property <bool> mc-running;
    // alle umbenannten Ordner haben eine neue Datenbank (grüner Punkt)
    property <bool> renamed-ready: root.renamed.length > 0 && root.ready-count == root.renamed.length;
    in property <int> ready-count;
    // Frage beim Zurückbenennen; kind: 0 neue Dateien, 1 Dateien fehlen/geändert, 2 Datenbank noch nicht neu
    in property <int> q-kind;
    in property <string> q-folder;
    in property <string> q-original;
    in property <int> q-count;
    in property <[string]> q-names;
    in property <string> q-first;
    in property <[NoticeRow]> notice;
    // Rebalancing: volle Ordner zur Auswahl, frühere Rebalancings (rückgängig machen), Zusammenfassung danach
    in property <[RebalRow]> rebalance-rows;
    in property <int> rebalance-selected;
    in property <[RunRow]> rebalanced;
    // Läufe, deren Datenbanken noch nicht neu geschrieben sind
    in property <int> rebalance-pending;
    in property <string> rebalance-summary;
    out property <string> txt-settings-menu: @tr("Settings…");
    out property <string> txt-mc-not-started: @tr("Media Composer could not be started.");
    out property <string> txt-choose-folder: @tr("Choose a drive or MXF folder");
    out property <string> txt-choose: @tr("Choose the folder with your Avid projects");
    out property <string> txt-choose-drive: @tr("Choose…");
    out property <string> txt-skip: @tr("Don't send");
    out property <string> txt-same-system: @tr("this manifest is from this system");
    out property <string> txt-choose-target: @tr("Choose where to create the delivery folder");
    out property <string> txt-choose-delivery: @tr("Choose the delivery folder");
    out property <string> txt-quit-mc: @tr("Quit Media Composer first.");
    out property <string> txt-task-check: @tr("Check…");
    out property <string> txt-task-rewrite: @tr("Rewrite databases");
    out property <string> txt-task-rebalancing: @tr("Maintain › Rebalancing");
    out property <string> txt-task-duplicates: @tr("Maintain › Duplicates");
    out property <string> txt-task-start: @tr("Start");
    out property <string> txt-task-rename-back: @tr("Rename {} folders back after Media Composer has written their databases", "{}");
    out property <string> txt-task-maintain: @tr("Maintain › Rename");
    out property <string> txt-task-open: @tr("Open");
    out property <string> txt-task-for: @tr("Delivery for {}", "{}");
    out property <string> txt-task-from: @tr("Delivery from {}", "{}");
    out property <string> txt-reading-drives: @tr("Reading the media databases of the drives…");
    out property <string> txt-one-file: @tr("1 file");
    out property <string> txt-relink: @tr("on the drives – relink");
    out property <string> txt-files-n: @tr("{} files", "{}"); // Rust fills in the number
    out property <string> txt-subclip: @tr("subclip");
    out property <string> txt-sequence: @tr("sequence");
    out property <string> txt-more-rows: @tr("… more in the saved list");
    out property <string> txt-more: @tr("… and {} more (see report)", "{}"); // Rust fills in the number

    callback toggle-drive(int);
    callback check-drives();
    callback check-folder();
    callback save-report();
    callback back();
    callback show-rename();
    callback rename();
    callback rename-back();
    callback start-media-composer();
    callback answer(int);
    callback find-full();
    callback toggle-rebalance(int);
    callback rebalance();
    callback rebalance-db(int);
    callback undo-rebalance(int);
    // Duplikate: Ergebnis, Auswahl, Verlauf
    in property <[DupGroup]> dup-groups;
    in property <string> dup-summary;
    in property <int> dup-selected;
    in property <string> dup-done-summary;
    in property <[RunRow]> dup-runs;
    in property <int> dup-pending;
    callback find-dups();
    callback toggle-dup(int);
    callback keep-copy(int, int);
    callback save-dups();
    callback set-aside-dups();
    callback dup-db(int);
    callback undo-dup(int);
    // Media-Composer-Ordner vor dem Rebalancing umbenennen: Name bestätigen oder ohne Umbenennen weiter
    callback rename-main(string);
    callback keep-main();
    in property <string> ask-folder;
    in property <string> ask-error;
    in-out property <string> ask-name;

    property <int> dot-count;
    property <string> dots: root.dot-count == 1 ? ".  " : root.dot-count == 2 ? ".. " : root.dot-count == 3 ? "..." : "   ";
    Timer {
        interval: 400ms;
        running: root.page == Page.working;
        triggered => { root.dot-count = Math.mod(root.dot-count + 1, 4); }
    }

    frame := VerticalLayout {
        // Titelleiste (28) + Reiter (52) wie im Einstellungsfenster
        Rectangle {
            height: 80px;
            background: Theme.dark ? (root.active ? #383838 : #292929) : (root.active ? #f0f0f0 : #e7e7e7);
            HorizontalLayout {
                alignment: center;
                padding-top: 28px;
                padding-bottom: 7px;
                spacing: 4px;
                SettingsTab {
                    icon: @image-url("../assets/tabs/exchange.png");
                    text: @tr("Exchange");
                    selected: root.tab == 0;
                    clicked => { root.select-tab(0); }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/check.png");
                    text: @tr("Check");
                    selected: root.tab == 1;
                    clicked => { root.select-tab(1); }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/projects.png");
                    text: @tr("Projects");
                    selected: root.tab == 2;
                    clicked => { root.select-tab(2); }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/maintain.png");
                    text: @tr("Maintain");
                    selected: root.tab == 3;
                    attention: root.renamed.length > 0 || root.runs-open > 0;
                    clicked => { root.select-tab(3); }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/tasks.png");
                    text: @tr("Tasks");
                    selected: root.tab == 4;
                    attention: Tasks.open.length > 0;
                    clicked => { root.select-tab(4); }
                }
            }
        }
        Rectangle {
            height: 0.5px;
            background: Theme.dark ? #000000 : #c6c6c6;
        }
        // neue Version: Hinweis zwischen Reitern und Inhalt
        if Shared.update-version != "": Rectangle {
            background: Theme.sidebar;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Version {} is available.", Shared.update-version);
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    CheckButton {
                        text: @tr("What's new");
                        small: true;
                        clicked => { Shared.show-release(); }
                    }
                    CheckButton {
                        text: @tr("Install update");
                        small: true;
                        primary: true;
                        enabled: Shared.update-state != 3;
                        clicked => { Shared.install-update(); }
                    }
                }
                UpdateStatus { width: 800px - 32px; }
            }
        }
        if Shared.update-version != "": Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
        // Seitenleiste: Schritte des Reiters in der Reihenfolge, in der man sie macht
        Rectangle {
            width: 172px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                alignment: start;
                for st[i] in root.steps: SideItem {
                    step: st;
                    selected: i == (root.tab == 2 ? Projects.view : root.tab == 0 ? Exchange.view : root.tab == 4 ? Tasks.view : root.step);
                    clicked => {
                        if root.tab == 4 { Tasks.view = i; }
                        if root.tab == 2 { Projects.view = i; }
                        if root.tab == 0 { Exchange.view = i; }
                        root.page = root.start-of(root.tab, i);
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
    page-flick := Flickable {
        content-height: main.preferred-height;
    main := VerticalLayout {
        width: page-flick.width;
        padding: 24px;
        padding-top: 20px;
        spacing: Metrics.spacing;

        // ── Start ──────────────────────────────────────────────
        // ── Prüfen › Laufwerke ──
        if root.page == Page.home: VerticalLayout {
            spacing: 14px;
            PageHead {
                title: @tr("Check drives");
                CheckButton {
                    text: @tr("Check folder…");
                    clicked => { root.check-folder(); }
                }
                CheckButton {
                    text: @tr("Check");
                    primary: true;
                    enabled: root.selected-count > 0;
                    clicked => { root.check-drives(); }
                }
            }
            Para {
                text: @tr("Compares the MXF files in every folder with the folder's Avid database and lists every difference. Nothing is changed.");
            }
            if root.drives.length == 0: Text {
                text: @tr("No drive with “Avid MediaFiles/MXF” found.");
                overflow: elide;
                color: Theme.muted;
            }
            if root.drives.length == 0: Para {
                text: @tr("Connect a drive with Avid media. If macOS asks whether MediaFiles Check may access files on removable or network volumes, allow it.");
                color: Theme.faint;
            }
            if root.drives.length > 0: ScrollBox {
                limit: 6 * 22px + 5 * 10px;
                spacing: 10px;
                for d[i] in root.drives: HorizontalLayout {
                    height: 22px;
                    spacing: 10px;
                    Dot { color: Theme.online; }
                    Text {
                        text: d.name;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                        color: d.selected ? Theme.text : Theme.muted;
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: d.selected;
                            label: d.name;
                            toggled => { root.toggle-drive(i); }
                        }
                    }
                }
            }
            Para {
                text: @tr("The switches apply to Exchange › Scan too.");
                color: Theme.faint;
            }
            StatusLine {
                text: root.error;
                color: Theme.error;
            }
        }

        // ── Pflegen › Umbenennen ──
        if root.page == Page.maintain: VerticalLayout {
            spacing: 14px;
            PageHead {
                title: @tr("Rename for Media Composer");
                if root.renamed.length > 0: CheckButton {
                    text: @tr("Start Media Composer");
                    enabled: !root.mc-running;
                    clicked => { root.start-media-composer(); }
                }
                if root.renamed.length > 0: CheckButton {
                    text: @tr("Rename back");
                    primary: true;
                    enabled: !root.mc-running;
                    clicked => { root.rename-back(); }
                }
            }
            FlowStrip {
                parts: [@tr("Rename"), @tr("Media Composer writes"), @tr("Rename back")];
                current: root.renamed.length == 0 ? 0 : root.renamed-ready ? 2 : 1;
            }
            if root.renamed.length == 0: Para {
                text: @tr("No folder is renamed right now. Folders are renamed for Media Composer from a check result (Check › Result) or when rebalancing and setting duplicates aside.");
            }
            if root.renamed.length > 0: ScrollBox {
                limit: 5 * 18px + 4 * 10px;
                spacing: 10px;
                for r in root.renamed: HorizontalLayout {
                    spacing: 10px;
                    height: Metrics.line;
                    Dot { color: r.status == 2 ? Theme.online : r.status == 1 ? Theme.warning : Theme.line; }
                    Text {
                        text: @tr("{} (was {})", r.current, r.original);
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    Text {
                        text: r.status == 2 ? @tr("ready") : r.status == 1 ? @tr("waiting") : @tr("drive missing");
                        font-size: 12px;
                        vertical-alignment: center;
                        color: Theme.muted;
                    }
                }
            }
            if root.renamed.length > 0: Para {
                text: @tr("Start Media Composer and wait until it has scanned the drives – the dot turns green once it has written the database. Then quit Media Composer and rename the folders back.");
            }
            if root.mc-running: StatusLine {
                text: @tr("Quit Media Composer before renaming back.");
                color: Theme.warning;
            }
        }

        // ── Pflegen › Rebalancing ──
        if root.page == Page.rebalstart: VerticalLayout {
            spacing: 14px;
            PageHead {
                title: @tr("Rebalancing");
                CheckButton {
                    text: @tr("Find full folders…");
                    primary: true;
                    enabled: root.selected-count > 0;
                    clicked => { root.find-full(); }
                }
            }
            FlowStrip {
                parts: [@tr("Rebalance"), @tr("Rewrite databases"), @tr("Rename back")];
                current: root.rebalance-pending > 0 ? 1 : 0;
            }
            Para {
                text: @tr("Splits MXF folders with more than {} files (database included): the oldest media files move into new folders.", Shared.limit);
            }
            if root.rebalance-pending > 0: HorizontalLayout {
                spacing: 10px;
                Para {
                    width: Metrics.content-width - 140px;
                    text: @tr("{n} run is waiting for new databases (History)." | "{n} runs are waiting for new databases (History)." % root.rebalance-pending);
                    color: Theme.warning;
                }
                CheckButton {
                    text: @tr("History");
                    small: true;
                    clicked => { root.page = Page.runs; }
                }
            }
        }

        // ── Pflegen › Duplikate ──
        if root.page == Page.dupsstart: VerticalLayout {
            spacing: 14px;
            PageHead {
                title: @tr("Duplicates");
                CheckButton {
                    text: @tr("Find duplicates…");
                    primary: true;
                    enabled: root.selected-count > 0;
                    clicked => { root.find-dups(); }
                }
            }
            FlowStrip {
                parts: [@tr("Set aside"), @tr("Rewrite databases"), @tr("Rename back")];
                current: root.dup-pending > 0 ? 1 : 0;
            }
            Para {
                text: @tr("Finds media files that are on the selected drives more than once – by their Media Composer ID, also when renamed.");
            }
            if root.dup-pending > 0: HorizontalLayout {
                spacing: 10px;
                Para {
                    width: Metrics.content-width - 140px;
                    text: @tr("Databases not rewritten yet");
                    color: Theme.warning;
                }
                CheckButton {
                    text: @tr("History");
                    small: true;
                    clicked => { root.page = Page.runs; }
                }
            }
        }

        if root.page == Page.projects: ProjectsPane { }

        if root.page == Page.exchange: ExchangePane { }

        if root.page == Page.tasks: TasksPane { }

        // ── Fortschritt ────────────────────────────────────────
        if root.page == Page.working: Section {
            title: @tr("CHECKING");
            ProgressBar { value: root.work-value; }
            StatusLine {
                text: root.work-text;
                color: Theme.muted;
            }
            Text {
                text: @tr("Please wait{}", root.dots);
                font-size: 12px;
                color: Theme.faint;
            }
        }

        // ── Ergebnis ───────────────────────────────────────────
        if root.page == Page.result: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: root.checked-folders == 0 ? @tr("No MXF folders found")
                            : root.bad-folders == 0 ? @tr("{n} folder matches its database" | "All {n} folders match their database" % root.checked-folders)
                            : @tr("{n} folder of {} differs from its database" | "{n} folders of {} differ from their database" % root.bad-folders, root.checked-folders);
                if root.bad-folders > 0: CheckButton {
                    text: @tr("Save report…");
                    clicked => { root.save-report(); }
                }
                CheckButton {
                    text: @tr("Done");
                    primary: true;
                    clicked => { root.back(); }
                }
            }
            if root.rows.length > 0: Section {
                title: @tr("DIFFERENCES");
                RowList { rows: root.rows; }
                Para {
                    text: @tr("Files not in the database may be missing in Media Composer; entries without a file show up as offline media. To rebuild a database: quit Media Composer, move msmMMOB.mdb and msmFMID.pmr out of the folder and start Media Composer again.");
                    font-size: 11px;
                    color: Theme.faint;
                }
            }
            if root.rename-count > 0: Section {
                title: @tr("FOR MEDIA COMPOSER");
                Para {
                    text: @tr("{n} of these folders has a name Media Composer does not update. MediaFiles Check can rename it so that Media Composer rebuilds its database, and rename it back afterwards." | "{n} of these folders have names Media Composer does not update. MediaFiles Check can rename them so that Media Composer rebuilds their databases, and rename them back afterwards." % root.rename-count);
                }
                HorizontalLayout {
                    alignment: start;
                    CheckButton {
                        text: @tr("Rename for Media Composer…");
                        clicked => { root.show-rename(); }
                    }
                }
            }
        }

        // ── Umbenennen ─────────────────────────────────────────
        if root.page == Page.rename: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Rename for Media Composer");
                CheckButton {
                    text: @tr("Back");
                    clicked => { root.page = Page.result; }
                }
                CheckButton {
                    text: @tr("Rename");
                    primary: true;
                    enabled: !root.mc-running;
                    clicked => { root.rename(); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                Rectangle {
                    height: min(rl.preferred-height, 240px);
                    rf := Flickable {
                        content-height: rl.preferred-height;
                        rl := VerticalLayout {
                            x: 0;
                            width: rf.width - 10px;
                            spacing: 6px;
                            for r in root.rename-rows: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: r.from;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "→ " + r.to;
                                    color: Theme.muted;
                                }
                            }
                        }
                    }
                }
                Para {
                    text: @tr("The original names and all media files are remembered. Once Media Composer has rebuilt the databases, rename the folders back under Maintain › Rename.");
                }
                Para {
                    text: root.mc-running ? @tr("Quit Media Composer first.") : @tr("Media Composer must stay closed while renaming.");
                    color: Theme.warning;
                }
            }
        }

        // ── Frage beim Zurückbenennen ─────────────────────────
        if root.page == Page.question: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Rename back: {} → {}", root.q-folder, root.q-original);
            }
            VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.q-kind == 0 ? @tr("{n} new file since renaming" | "{n} new files since renaming" % root.q-count)
                        : root.q-kind == 1 ? @tr("{n} file missing or changed since renaming" | "{n} files missing or changed since renaming" % root.q-count)
                        : @tr("Media Composer has not rewritten the database yet");
                    width: Metrics.content-width;
                    wrap: word-wrap;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                }
                for n in root.q-names: Text {
                    text: n;
                    font-size: 12px;
                    overflow: elide;
                    color: Theme.muted;
                }
                if root.q-kind == 0: Para {
                    text: @tr("Media Composer probably recorded them while the folder had its new name. If you move them, the folder's database still lists them until it is rebuilt again.");
                }
            }
            VerticalLayout {
                spacing: 8px;
                if root.q-kind == 0: CheckButton {
                    text: @tr("Move to a new folder");
                    clicked => { root.answer(1); }
                }
                if root.q-kind == 0: CheckButton {
                    text: @tr("Move to folder {}", root.q-first);
                    clicked => { root.answer(2); }
                }
                if root.q-kind == 0: CheckButton {
                    text: @tr("Keep them in the folder");
                    clicked => { root.answer(0); }
                }
                if root.q-kind != 0: CheckButton {
                    text: @tr("Rename back anyway");
                    clicked => { root.answer(0); }
                }
                CheckButton {
                    text: @tr("Leave it renamed for now");
                    clicked => { root.answer(-1); }
                }
            }
        }

        // ── Abschluss ─────────────────────────────────────────
        // ── Rebalancing: Auswahl ──────────────────────────────
        if root.page == Page.rebalance: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Rebalancing");
                CheckButton {
                    text: @tr("Back");
                    clicked => { root.back(); }
                }
                if root.rebalance-rows.length > 0: CheckButton {
                    text: @tr("Rebalance");
                    primary: true;
                    enabled: !root.mc-running && root.rebalance-selected > 0;
                    clicked => { root.rebalance(); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                if root.rebalance-rows.length == 0: Para {
                    text: @tr("No folder on the selected drives has more than {} files, the two database files included.", Shared.limit);
                }
                if root.rebalance-rows.length > 0: ScrollBox {
                    limit: 300px;
                    spacing: 12px;
                            for r[i] in root.rebalance-rows: HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: r.title; overflow: elide; color: r.selected ? Theme.text : Theme.muted; }
                                    Text {
                                        width: Metrics.content-width - 72px;
                                        text: r.detail;
                                        wrap: word-wrap;
                                        font-size: 11px;
                                        color: Theme.muted;
                                    }
                                    if r.note != "": Text {
                                        width: Metrics.content-width - 72px;
                                        text: r.note;
                                        wrap: word-wrap;
                                        font-size: 11px;
                                        color: Theme.warning;
                                    }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    if !r.blocked: Switch {
                                        on: r.selected;
                                        label: r.title;
                                        toggled => { root.toggle-rebalance(i); }
                                    }
                                }
                            }
                }
                if root.rebalance-rows.length > 0: Para {
                    text: @tr("The oldest media files go into the rebalanced folders, the youngest stay in the main folder; nothing is copied or deleted. Afterwards the databases of the changed folders have to be rewritten. You can undo it under History.");
                }
                if root.rebalance-rows.length > 0: Para {
                    text: root.mc-running ? @tr("Quit Media Composer first.") : @tr("Media Composer must stay closed while moving – on network drives on every workstation.");
                    color: Theme.warning;
                }
            }
        }

        // ── Rebalancing: danach Datenbanken neu schreiben ─────
        if root.page == Page.rebalanced: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Rebalanced");
                CheckButton {
                    text: @tr("Cancel");
                    clicked => { root.back(); }
                }
                CheckButton {
                    text: @tr("Start");
                    primary: true;
                    enabled: !root.mc-running;
                    clicked => { root.rebalance-db(-1); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                ScrollBox {
                    limit: 200px;
                    Para { text: root.rebalance-summary; color: Theme.text; }
                }
                Para {
                    text: @tr("Now the databases of the changed folders have to be rewritten. Start sets their databases aside (Media Composer writes new ones) and renames the folders Media Composer does not update itself – then go on under Maintain › Rename.");
                }
                Para {
                    text: @tr("Cancel leaves the databases as they are – you can start it later under Maintain › History.");
                }
                Para {
                    text: root.mc-running ? @tr("Quit Media Composer first.") : "";
                    color: Theme.warning;
                }
            }
        }

        // ── Rebalancing: Media-Composer-Ordner umbenennen? ──
        if root.page == Page.askname: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Rename folder?");
                CheckButton {
                    text: @tr("Keep the name");
                    clicked => { root.keep-main(); }
                }
                CheckButton {
                    text: @tr("Rename");
                    primary: true;
                    clicked => { root.rename-main(root.ask-name); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                Para {
                    text: @tr("“{}” is a folder Media Composer creates and fills itself. We recommend giving it a name of its own before rebalancing – the folder and its rebalanced folders then carry that name, and Media Composer starts a new folder for new media.", root.ask-folder);
                    color: Theme.text;
                }
                Text { text: @tr("New name"); font-size: 12px; color: Theme.muted; }
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.ask-error != "" ? Theme.error : Theme.line;
                    name-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.ask-name;
                        font-size: 13px;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: @tr("New name");
                        init => { self.focus(); }
                        accepted => { root.rename-main(self.text); }
                    }
                }
                if root.ask-error != "": StatusLine { text: root.ask-error; color: Theme.error; }
            }
        }

        // ── Duplikate: Ergebnis ──
        if root.page == Page.dups: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Duplicates");
                CheckButton {
                    text: @tr("Save report…");
                    clicked => { root.save-dups(); }
                }
                CheckButton {
                    text: @tr("Back");
                    clicked => { root.back(); }
                }
                if root.dup-groups.length > 0: CheckButton {
                    text: @tr("Set aside");
                    primary: true;
                    enabled: !root.mc-running && root.dup-selected > 0;
                    clicked => { root.set-aside-dups(); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                Para { text: root.dup-summary; color: Theme.text; }
                if root.dup-groups.length > 0: ScrollBox {
                    limit: 300px;
                    spacing: 16px;
                    for g[gi] in root.dup-groups: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: g.title; overflow: elide; font-weight: 600; color: g.selected ? Theme.text : Theme.muted; }
                                Text { width: Metrics.content-width - 72px; text: g.detail; wrap: word-wrap; font-size: 11px; color: Theme.muted; }
                                if g.note != "": Text { width: Metrics.content-width - 72px; text: g.note; wrap: word-wrap; font-size: 11px; color: Theme.warning; }
                            }
                            VerticalLayout {
                                alignment: start;
                                if !g.blocked: Switch {
                                    on: g.selected;
                                    label: g.title;
                                    toggled => { root.toggle-dup(gi); }
                                }
                            }
                        }
                        // Klick auf eine Kopie: diese bleibt
                        for c[ci] in g.copies: Rectangle {
                            height: 18px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: c.keep ? Theme.online : transparent;
                                        border-width: c.keep ? 0px : 1px;
                                        border-color: Theme.muted;
                                    }
                                }
                                Text { text: c.place; horizontal-stretch: 1; overflow: elide; font-size: 11px; vertical-alignment: center; color: c.keep ? Theme.text : Theme.muted; }
                                Text { text: c.keep ? @tr("stays") : @tr("set aside"); font-size: 11px; vertical-alignment: center; color: Theme.faint; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.keep-copy(gi, ci); }
                            }
                        }
                    }
                }
                if root.dup-groups.length > 0: Para {
                    text: @tr("Click a copy to keep it. The others go into “MediaFiles Check Duplicates” on their drive – nothing is deleted, you can undo it under Maintain › History.");
                }
                if root.dup-groups.length > 0: Para {
                    text: root.mc-running ? @tr("Quit Media Composer first.") : @tr("Media Composer must stay closed while moving – on network drives on every workstation.");
                    color: Theme.warning;
                }
            }
        }

        // ── Duplikate: danach Datenbanken neu schreiben ──
        if root.page == Page.dupsdone: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Copies set aside");
                CheckButton {
                    text: @tr("Cancel");
                    clicked => { root.back(); }
                }
                CheckButton {
                    text: @tr("Start");
                    primary: true;
                    enabled: !root.mc-running;
                    clicked => { root.dup-db(-1); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                ScrollBox {
                    limit: 200px;
                    Para { text: root.dup-done-summary; color: Theme.text; }
                }
                Para {
                    text: @tr("Now the databases of the changed folders have to be rewritten. Start sets their databases aside (Media Composer writes new ones) and renames the folders Media Composer does not update itself – then go on under Maintain › Rename.");
                }
                Para {
                    text: @tr("Cancel leaves the databases as they are – you can start it later under Maintain › History.");
                }
                Para {
                    text: root.mc-running ? @tr("Quit Media Composer first.") : "";
                    color: Theme.warning;
                }
            }
        }

        // ── Rebalancing: frühere Läufe (Datenbanken neu schreiben, rückgängig machen) ──
        // ── Verlauf: alle Läufe von Rebalancing und Duplikaten (Datenbanken neu schreiben, rückgängig machen) ──
        if root.page == Page.runs: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead { title: @tr("History"); }
            ScrollBox {
                limit: 420px;
                spacing: Metrics.spacing;
                Section {
                    title: @tr("REBALANCING");
                    if root.rebalanced.length == 0: Para { text: @tr("No runs yet."); }
                    for r[i] in root.rebalanced: VerticalLayout {
                        spacing: 8px;
                        Text {
                            width: Metrics.content-width - 12px;
                            text: r.text;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: Theme.text;
                        }
                        if !r.db-done: Text {
                            text: @tr("Databases not rewritten yet");
                            font-size: 12px;
                            color: Theme.warning;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            if !r.db-done: CheckButton {
                                text: @tr("Rewrite databases");
                                small: true;
                                enabled: !root.mc-running;
                                clicked => { root.rebalance-db(i); }
                            }
                            CheckButton {
                                text: @tr("Undo");
                                small: true;
                                enabled: !root.mc-running;
                                clicked => { root.undo-rebalance(i); }
                            }
                        }
                    }
                }
                Section {
                    title: @tr("DUPLICATES");
                    if root.dup-runs.length == 0: Para { text: @tr("No runs yet."); }
                    for r[i] in root.dup-runs: VerticalLayout {
                        spacing: 8px;
                        Text {
                            width: Metrics.content-width - 12px;
                            text: r.text;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: Theme.text;
                        }
                        if !r.db-done: Text {
                            text: @tr("Databases not rewritten yet");
                            font-size: 12px;
                            color: Theme.warning;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            if !r.db-done: CheckButton {
                                text: @tr("Rewrite databases");
                                small: true;
                                enabled: !root.mc-running;
                                clicked => { root.dup-db(i); }
                            }
                            CheckButton {
                                text: @tr("Undo");
                                small: true;
                                enabled: !root.mc-running;
                                clicked => { root.undo-dup(i); }
                            }
                        }
                    }
                }
            }
            if root.mc-running: StatusLine {
                text: @tr("Quit Media Composer first.");
                color: Theme.warning;
            }
        }

        if root.page == Page.notice: VerticalLayout {
            spacing: Metrics.spacing;
            PageHead {
                title: @tr("Result");
                CheckButton {
                    text: @tr("Done");
                    primary: true;
                    clicked => { root.back(); }
                }
            }
            VerticalLayout {
                spacing: 10px;
                ScrollBox {
                    limit: 360px;
                    spacing: 10px;
                    for r in root.notice: Text {
                        width: Metrics.content-width - 12px;
                        wrap: word-wrap;
                        font-size: 12px;
                        text: r.kind == 0 ? @tr("{} renamed back to {}", r.a, r.b)
                            : r.kind == 1 ? @tr("{n} new file moved to {}" | "{n} new files moved to {}" % r.n, r.a)
                            : r.kind == 2 ? @tr("{} stays renamed", r.a)
                            : r.kind == 3 ? @tr("{}: {}", r.a, r.b)
                            : r.kind == 5 ? @tr("{n} file moved back to {}" | "{n} files moved back to {}" % r.n, r.a)
                            : r.kind == 6 ? @tr("{} kept – it holds other files", r.a)
                            : r.kind == 7 ? @tr("{n} file left where it is (changed, or the name exists again): {}" | "{n} files left where they are (changed, or the name exists again): {}" % r.n, r.a)
                            : r.kind == 8 ? @tr("Database of {} set aside: {}", r.a, r.b)
                            : @tr("not moved, the target has a file with this name: {}", r.a);
                        color: r.kind == 3 ? Theme.error : r.kind == 4 || r.kind == 2 || r.kind == 6 || r.kind == 7 ? Theme.warning : Theme.text;
                    }
                }
            }
        }
    }
    }
    ScrollThumb { x: parent.width - self.width - 2px; view: page-flick.height; content: main.preferred-height; offset: page-flick.content-y; }
        }
        }
    }

    // ── Erster Start ──
    if root.show-welcome: Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: 520px;
            height: card.preferred-height;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.background;
            card := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: @tr("Welcome to MediaFiles Check");
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.text;
                }
                for t[i] in [
                    { a: @tr("Exchange"), b: @tr("keeps the media of two edit systems in step – formerly MediaFiles Ferry.") },
                    { a: @tr("Check"), b: @tr("compares every MXF folder with its Avid database.") },
                    { a: @tr("Projects"), b: @tr("finds the media your bins need that are on none of the drives.") },
                    { a: @tr("Maintain"), b: @tr("renames folders for Media Composer, rebalances full folders, sets duplicates aside.") },
                    { a: @tr("Tasks"), b: @tr("lists everything that has to be done by hand.") },
                ]: HorizontalLayout {
                    spacing: 10px;
                    Text { text: t.a; width: 90px; font-size: 12px; font-weight: 600; color: Theme.text; }
                    Text { text: t.b; width: 520px - 48px - 100px; wrap: word-wrap; font-size: 12px; color: Theme.muted; }
                }
                Text {
                    width: 520px - 48px;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("MediaFiles Check never deletes or overwrites a media file. Still, keep a backup of your media – you use it at your own risk.");
                }
                Text {
                    width: 520px - 48px;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.faint;
                    text: @tr("When macOS asks whether MediaFiles Check may access files on removable or network volumes, allow it – until then reading such a drive waits.");
                }
                HorizontalLayout {
                    alignment: end;
                    CheckButton {
                        text: @tr("Get started");
                        primary: true;
                        clicked => { root.welcome-done(); }
                    }
                }
            }
        }
    }
}

// Anleitung: gleiche Schrift, Farben und Abstände wie das Hauptfenster; Inhalt aus docs/help/<sprache>.md.
export component HelpWindow inherits CheckWindow {
    title: @tr("MediaFiles Check Manual");
    width: 720px;
    height: 860px;

    in property <string> subtitle;
    in property <[HelpBlock]> blocks;

    VerticalLayout {
        padding: Metrics.padding;
        spacing: Metrics.spacing;

        Headline { }
        Section {
            title: root.subtitle;
        }
        Divider { }
        // eigene Scrollfläche: die Standard-ScrollView rückt den Inhalt ein
        Rectangle {
            vertical-stretch: 1;
            flick := Flickable {
                content-height: content.preferred-height;
                content := VerticalLayout {
                    x: 0;
                    width: flick.width - 16px;
                    spacing: 12px;
                    padding-bottom: 16px;
                    for b in root.blocks: VerticalLayout {
                        padding-top: b.heading != "" ? 16px : 0;
                        if b.heading != "": Text {
                            text: b.heading;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                        }
                        // feste Breite: sonst misst Slint den Absatz ungebrochen und die Scrollhöhe ist zu klein
                        // framed: the screenshots are dark and would blend into the page
                        if b.picture.width > 0: Rectangle {
                            width: min(content.width, b.picture.width * 0.5px + 2px);
                            height: (self.width - 2px) * b.picture.height / b.picture.width + 2px;
                            border-width: 1px;
                            border-color: Theme.line;
                            border-radius: 6px;
                            clip: true;
                            Image {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                source: b.picture;
                            }
                        }
                        if b.heading == "" && b.picture.width == 0: StyledText {
                            width: content.width;
                            text: b.body;
                            default-color: Theme.text;
                            link-color: Theme.text;
                        }
                    }
                }
            }
            if flick.content-height > flick.height: Rectangle {
                x: parent.width - self.width;
                width: 4px;
                height: max(24px, flick.height * flick.height / flick.content-height);
                y: -flick.content-y / (flick.content-height - flick.height) * (flick.height - self.height);
                border-radius: 2px;
                background: Theme.line;
            }
        }
    }
}

// Einstellungen (App-Menü → Settings…, ⌘,): wie in Mountpoint – Darstellung als Schalter, Sprache als Auswahl.
// Reiter oben wie Mountpoints Einstellungs-Werkzeugleiste (NSToolbar .preference): Symbol über dem Namen in der
// Systemschrift, der aktive Reiter hinterlegt und in Systemblau

// Zeile wie in Mountpoint: kurzer Text links, Bedienelement rechtsbündig
component SettingRow inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    Text {
        text: root.text;
        // Mountpoints Regular wirkt mit CoreText (dunkel, kleine Größen) fast halbfett; Slint zeichnet dünner
        font-weight: 600;
        horizontal-stretch: 1;
        vertical-alignment: center;
        wrap: word-wrap;
        color: Theme.text;
    }
    @children
}

// Erklärung unter einer Zeile (Mountpoint: hint, 11 pt, blass, höchstens 390 breit)
component Hint inherits Text {
    width: 390px;
    wrap: word-wrap;
    font-size: 11px;
    color: Theme.faint;
}

// Rollbalken wie macOS' Overlay-Scroller in Mountpoints ScrollView: 6 px, abgerundet, 2 px vom Rand

// Rahmen wie Mountpoints Eingabefelder: 1 px Linie, Ecken 6, keine eigene Fläche
component FieldFrame inherits Rectangle {
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
}

// Einstellungen wie in Mountpoint (seit 1.0.0 beta 7): eigenes Fenster 800 × 450 (16:9, nie größer), Inhalt bis unter die
// durchsichtige Titelleiste (Rust: mac_window::unify_titlebar), Reiterleiste in der Farbe der Titelleiste – heller,
// solange das Fenster aktiv ist (active, von Rust gesetzt) –, Titel = Reiter, Spalte von 560 px mittig.
// Kein Reiter wächst oder scrollt – nur die Selbsttest-Liste und das Beschreibungsfeld scrollen in sich.
export component SettingsWindow inherits CheckWindow {
    // gleiche Wirkung wie Mountpoints Regular mit CoreText (gemessen: Slint-Text sonst rund 20 % heller)
    default-font-weight: 500;
    title: root.tab == 0 ? @tr("General") : root.tab == 1 ? @tr("Updates") : root.tab == 2 ? @tr("Support") : root.tab == 4 ? @tr("Rebalancing") : @tr("About");
    width: 800px;
    height: 450px;

    // Reiter: 0 Allgemein, 4 Rebalancing (steht als zweiter), 1 Updates, 2 Support, 3 Über; last-tab = zuletzt gewählter außer „Über“ (für „Einstellungen…“,
    // in settings.txt gesichert)
    in-out property <int> tab;
    in-out property <int> last-tab;
    // Grenze ändern erst nach der Warnung (jede Änderung verteilt beim nächsten Suchen alle rebalanced-Ordner neu)
    in-out property <bool> limit-ask;
    in-out property <int> limit-new;
    in-out property <bool> limit-revert;
    callback tab-chosen(int);
    changed tab => {
        if root.tab != 3 && root.tab != root.last-tab {
            root.last-tab = root.tab;
            root.tab-chosen(root.tab);
        }
    }
    in property <bool> active: true;
    in property <string> version;
    callback open-source();
    callback open-license();
    // Support (wie Mountpoint): 0 Übersicht, 1 Selbsttest, 2 Problem melden
    in-out property <int> page;
    // Selbsttest: 0 bereit, 1 läuft, 2 fertig
    in property <int> test-phase;
    in property <[TestRow]> test-rows;
    in property <string> test-current;
    in property <string> test-summary;
    in property <bool> test-failed;
    in property <string> test-note;
    in property <bool> sending;
    in-out property <string> report-text;
    in-out property <string> report-contact;
    in-out property <bool> report-attach: true;
    // kurze Meldung nach dem Senden wie Mountpoints Toast (Rust blendet sie nach 3 s, Fehler 8 s, aus)
    in property <string> toast-text;
    in property <bool> toast-ok;
    in property <bool> toast-visible;
    callback start-selftest();
    callback send-selftest();
    callback save-selftest();
    callback send-problem();
    callback open-coffee();
    callback back();

    property <length> column: 560px;

    VerticalLayout {
        // Titelleiste (28) + Reiter (52), gemessen an Mountpoint
        Rectangle {
            height: 80px;
            background: Theme.dark ? (root.active ? #383838 : #292929) : (root.active ? #f0f0f0 : #e7e7e7);
            HorizontalLayout {
                alignment: center;
                padding-top: 28px;
                padding-bottom: 7px;
                SettingsTab {
                    icon: @image-url("../assets/tabs/general.png");
                    text: @tr("General");
                    selected: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/rebalance.png");
                    text: @tr("Rebalancing");
                    selected: root.tab == 4;
                    clicked => { root.tab = 4; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/updates.png");
                    text: @tr("Updates");
                    selected: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/support.png");
                    text: @tr("Support");
                    selected: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
                SettingsTab {
                    icon: @image-url("../assets/tabs/about.png");
                    text: @tr("About");
                    selected: root.tab == 3;
                    clicked => { root.tab = 3; }
                }
            }
        }
        // Trennlinie unter der Werkzeugleiste wie bei macOS (ein Bildpunkt)
        Rectangle {
            height: 0.5px;
            background: Theme.dark ? #000000 : #c6c6c6;
        }
        HorizontalLayout {
            alignment: center;
            // Allgemein ist der Maßstab (wie Mountpoint): seine erste Zeile hat einen Schalter (20 hoch). Reiter, die mit
            // einem Knopf (26 hoch) beginnen, rücken 3 px höher, damit der erste Text überall auf derselben Höhe steht.
            padding-top: root.tab == 2 && root.page != 0 ? 16px : root.tab == 1 || root.tab == 2 || root.tab == 4 ? 21px : 24px;
            padding-bottom: 16px;

            if root.tab == 0: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Light/Dark");
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Shared.dark;
                            label: @tr("Light/Dark");
                            toggled => { Shared.select-dark(!Shared.dark); }
                        }
                    }
                }
                Hint { text: @tr("Switches all windows of MediaFiles Check between a light and a dark look."); }
                SettingRow {
                    text: @tr("Language");
                    VerticalLayout {
                        alignment: center;
                        Dropdown {
                            items: Shared.language-names;
                            current: Shared.language-index;
                            selected(i) => { Shared.select-language(i); }
                        }
                    }
                }
            }

            // Rebalancing: Obergrenze pro Ordner; ungültige Eingaben (keine Zahl, außerhalb 100–50000) werden nicht übernommen
            if root.tab == 4: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Files per folder");
                    FieldFrame {
                        width: 90px;
                        height: 26px;
                        border-color: limit-input.valid ? Theme.line : Theme.error;
                        limit-input := TextInput {
                            property <bool> valid: self.text.is-float() && self.text.to-float() >= 100 && self.text.to-float() <= 50000 && Math.round(self.text.to-float()) == self.text.to-float();
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: Shared.limit;
                            font-size: 12px;
                            color: Theme.text;
                            selection-background-color: Theme.accent.with-alpha(0.35);
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            single-line: true;
                            input-type: number;
                            accessible-label: @tr("Files per folder");
                            // „Abbrechen“ in der Warnung setzt das Feld zurück
                            property <bool> revert: root.limit-revert;
                            changed revert => { self.text = Shared.limit; }
                            accepted => { if self.valid && self.text.to-float() != Shared.limit { root.limit-new = self.text.to-float(); root.limit-ask = true; } }
                        }
                    }
                    if limit-input.valid && limit-input.text.to-float() != Shared.limit: CheckButton {
                        text: @tr("Change…");
                        small: true;
                        clicked => { root.limit-new = limit-input.text.to-float(); root.limit-ask = true; }
                    }
                }
                Hint { text: @tr("Counts every file of a folder, the two database files included – a folder keeps at most this many minus 2 media files. Rebalancing moves the oldest media files of a fuller folder into new folders. We recommend no more than 5000 (between 100 and 50000)."); }
                Hint { text: @tr("New folders get the name of the full folder with “-rebalanced-1”, “-2” … (“Mac Studio.1” becomes “Mac Studio-rebalanced-1”). After a change of the limit, the next “Find full folders…” lays them out anew."); }
            }

            if root.tab == 1: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: @tr("Version {}", Shared.version);
                    if Shared.update-state == 1: VerticalLayout {
                        alignment: center;
                        Spinner { indeterminate: true; width: 16px; height: 16px; }
                    }
                    CheckButton {
                        small: true;
                        text: @tr("Check for updates");
                        enabled: Shared.update-state != 1 && Shared.update-state != 3;
                        clicked => { Shared.check-update(); }
                    }
                }
                if Shared.update-version != "": UpdateOffer { text-width: root.column; }
                if Shared.update-state != 0: UpdateStatus {
                    width: root.column;
                    font-size: 11px;
                    color: Shared.update-state == 4 ? Theme.partial : Theme.faint;
                }
                Hint { text: @tr("MediaFiles Check checks GitHub for new versions on its own and shows a notice."); }
                SettingRow {
                    text: @tr("Get test versions");
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: Shared.betas;
                            label: @tr("Get test versions");
                            toggled => { Shared.select-betas(!Shared.betas); }
                        }
                    }
                }
                Hint { text: @tr("Also offers versions that are still being tested. For testers only – they can contain errors."); }
            }

            if root.tab == 2 && root.page == 0: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 14px;
                SettingRow {
                    text: root.test-phase == 1 ? @tr("Self-test running…") : @tr("Test this Mac");
                    CheckButton {
                        small: true;
                        text: @tr("Run self-test…");
                        clicked => { root.page = 1; }
                    }
                }
                Hint { text: @tr("Tests reading databases, comparing, renaming and updates on test data of its own and sends us an anonymous report."); }
                SettingRow {
                    text: @tr("Problem or idea?");
                    CheckButton {
                        small: true;
                        text: @tr("Report…");
                        clicked => { root.page = 2; }
                    }
                }
                Hint { text: @tr("No GitHub account needed."); }
                SettingRow {
                    text: @tr("Events and errors");
                    CheckButton {
                        small: true;
                        text: @tr("Show log file");
                        clicked => { Shared.show-log(); }
                    }
                }
                SettingRow {
                    text: @tr("Like MediaFiles Check?");
                    CheckButton {
                        small: true;
                        text: @tr("Buy me a coffee");
                        clicked => { root.open-coffee(); }
                    }
                }
                Hint { text: @tr("If you use MediaFiles Check and like it, I would be glad if you bought me a coffee."); }
            }

            // Selbsttest wie Mountpoints SelfTestView: feste Liste mit Rahmen, die mitscrollt – das Fenster wächst nie
            if root.tab == 2 && root.page == 1: VerticalLayout {
                width: root.column;
                alignment: start;
                // Liste 200 hoch wie in Mountpoint: etwas engere Abstände, damit alles ohne Scrollen passt
                spacing: 10px;
                Section {
                    title: @tr("SELF-TEST");
                    spacing: 8px;
                    if root.test-phase == 0: Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                        text: @tr("MediaFiles Check tests reading databases, comparing, renaming and updates on test data of its own and sends us an anonymous report. Your drives and folders are only listed, never changed. It takes less than a minute.");
                    }
                    if root.test-phase != 0: FieldFrame {
                        height: 200px;
                        flick := Flickable {
                            content-height: list.preferred-height;
                            // neue Zeile → ans Ende scrollen, wie Mountpoints scrollTo
                            property <length> filled: list.preferred-height;
                            changed filled => { self.content-y = min(0px, self.height - self.filled); }
                            list := VerticalLayout {
                                width: flick.width;
                                padding: 10px;
                                spacing: 8px;
                                for row in root.test-rows: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: 2px;
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            source: row.status == 0 ? @image-url("../assets/tabs/pass.png") : row.status == 1 ? @image-url("../assets/tabs/fail.png") : @image-url("../assets/tabs/skip.png");
                                            colorize: row.status == 0 ? Theme.online : row.status == 1 ? Theme.error : Theme.faint;
                                            accessible-role: image;
                                            accessible-label: row.status == 0 ? @tr("Passed") : row.status == 1 ? @tr("Failed") : @tr("Skipped");
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: row.title; font-size: 12px; color: Theme.text; }
                                        Text {
                                            width: root.column - 42px;
                                            text: row.detail;
                                            wrap: word-wrap;
                                            font-size: 10px;
                                            color: row.status == 1 ? Theme.error : Theme.faint;
                                        }
                                    }
                                }
                                if root.test-phase == 1: HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Spinner { indeterminate: true; width: 12px; height: 12px; }
                                    }
                                    Text { text: root.test-current; font-size: 12px; color: Theme.muted; }
                                }
                            }
                        }
                        ScrollThumb { x: parent.width - self.width - 2px; view: flick.height; content: list.preferred-height; offset: flick.content-y; }
                    }
                    if root.test-phase == 2: VerticalLayout {
                        padding-top: 2px;
                        spacing: 4px;
                        Text {
                            text: root.test-summary;
                            font-size: 12px;
                            font-weight: 600;
                            color: root.test-failed ? Theme.error : Theme.text;
                        }
                        Text {
                            width: root.column;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: Theme.faint;
                            text: root.test-note != "" ? root.test-note : @tr("Only anonymous data is sent: system, test results and the log with user and folder names replaced. Save the report to look at it first.");
                        }
                    }
                }
                Divider { }
                HorizontalLayout {
                    spacing: 10px;
                    CheckButton {
                        small: true;
                        text: root.test-phase == 1 ? @tr("Hide") : @tr("Back");
                        clicked => { root.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.test-phase == 0: CheckButton {
                        small: true;
                        text: @tr("Start self-test");
                        primary: true;
                        clicked => { root.start-selftest(); }
                    }
                    if root.test-phase == 1: VerticalLayout {
                        alignment: center;
                        Spinner { indeterminate: true; width: 16px; height: 16px; }
                    }
                    if root.test-phase == 2: CheckButton {
                        small: true;
                        text: @tr("Save report");
                        clicked => { root.save-selftest(); }
                    }
                    if root.test-phase == 2: CheckButton {
                        small: true;
                        text: root.sending ? @tr("Sending…") : @tr("Send report");
                        primary: true;
                        enabled: !root.sending;
                        clicked => { root.send-selftest(); }
                    }
                }
            }

            // Problem melden wie Mountpoints ProblemView: Felder mit Linie, ohne eigene Fläche
            if root.tab == 2 && root.page == 2: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 12px;
                Section {
                    title: @tr("REPORT A PROBLEM");
                    spacing: 12px;
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                        text: @tr("What happened, and what did you expect? Ideas are welcome too. No GitHub account needed.");
                    }
                    FieldFrame {
                        height: 100px;
                        editor := Flickable {
                            x: 6px;
                            y: 6px;
                            width: parent.width - 12px;
                            height: parent.height - 12px;
                            content-height: max(self.height, description.preferred-height);
                            // beim Tippen am Ende bleiben, wenn der Text länger als das Feld wird
                            property <length> filled: description.preferred-height;
                            changed filled => { self.content-y = min(0px, self.height - self.filled); }
                            description := TextInput {
                                width: editor.width;
                                font-size: 12px;
                                color: Theme.text;
                                selection-background-color: Theme.accent.with-alpha(0.35);
                                wrap: word-wrap;
                                single-line: false;
                                text <=> root.report-text;
                                accessible-label: @tr("Description");
                            }
                        ScrollThumb { x: parent.width - self.width - 2px; view: editor.height; content: description.preferred-height; offset: editor.content-y; y: 6px + 2px + (description.preferred-height > editor.height ? -editor.content-y / (description.preferred-height - editor.height) * (editor.height - 4px - self.height) : 0px); }
                        }
                    }
                    FieldFrame {
                        height: 26px;
                        if root.report-contact == "": Text {
                            x: 8px;
                            text: @tr("Email for questions (optional)");
                            font-size: 12px;
                            color: Theme.faint;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            font-size: 12px;
                            color: Theme.text;
                            selection-background-color: Theme.accent.with-alpha(0.35);
                            vertical-alignment: center;
                            single-line: true;
                            text <=> root.report-contact;
                            accessible-label: @tr("Email for questions (optional)");
                        }
                    }
                    SettingRow {
                        text: @tr("Attach system info and log file");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                on: root.report-attach;
                                label: @tr("Attach system info and log file");
                                toggled => { root.report-attach = !root.report-attach; }
                            }
                        }
                    }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("Anonymized: your user name and folder names are replaced.");
                    }
                }
                Divider { }
                HorizontalLayout {
                    spacing: 10px;
                    CheckButton {
                        small: true;
                        text: @tr("Back");
                        clicked => { root.back(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CheckButton {
                        small: true;
                        text: root.sending ? @tr("Sending…") : @tr("Send");
                        primary: true;
                        enabled: !root.sending && root.report-text != "";
                        clicked => { root.send-problem(); }
                    }
                }
            }

            // Über wie Mountpoints AboutView: Symbol, Name, Version, ©; Lizenz; Knöpfe; Drittanbieter
            if root.tab == 3: VerticalLayout {
                width: root.column;
                alignment: start;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 56px;
                        height: 56px;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text { text: "MediaFiles Check"; font-size: 15px; font-weight: 600; color: Theme.text; }
                        Text { text: @tr("Version {}", root.version); font-size: 12px; color: Theme.muted; }
                        Text { text: "© 2026 Moritz Poth"; font-size: 12px; color: Theme.muted; }
                    }
                }
                Text {
                    width: root.column;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("MediaFiles Check is free software: you can redistribute and modify it under the terms of the GNU General Public License, version 3 or later.");
                }
                Text {
                    width: root.column;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text;
                    text: @tr("It comes with ABSOLUTELY NO WARRANTY – use at your own risk.");
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    CheckButton {
                        small: true;
                        text: @tr("Source code");
                        clicked => { root.open-source(); }
                    }
                    CheckButton {
                        small: true;
                        text: @tr("License");
                        clicked => { root.open-license(); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("THIRD-PARTY"); font-size: 11px; font-weight: 600; letter-spacing: 1px; color: Theme.muted; }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("JetBrains Mono font – SIL Open Font License 1.1. Slint UI toolkit – used under the GNU GPL v3.");
                    }
                    Text {
                        width: root.column;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.faint;
                        text: @tr("Avid and Media Composer are trademarks of Avid Technology, Inc. MediaFiles Check is not affiliated with Avid.");
                    }
                }
            }
        }
    }

    // Warnung vor dem Ändern der Grenze: Karte über dem Fenster (Ferry-Stil, wie Mountpoints networkCard)
    if root.limit-ask: Rectangle {
        background: #00000066;
        TouchArea { }
        Rectangle {
            width: 460px;
            height: card.preferred-height;
            border-radius: 10px;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000059;
            card := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text { text: @tr("Change the limit to {}?", root.limit-new); font-size: 14px; font-weight: 700; color: Theme.text; }
                Text {
                    width: 460px - 44px;
                    text: @tr("The next “Find full folders…” lays out every rebalanced folder on the drives anew for this limit: media files move into more folders or back. With many files that can take a long time, and the databases of every changed folder have to be rewritten.");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    CheckButton {
                        text: @tr("Cancel");
                        small: true;
                        clicked => { root.limit-ask = false; root.limit-revert = !root.limit-revert; }
                    }
                    CheckButton {
                        text: @tr("Change");
                        small: true;
                        primary: true;
                        clicked => { root.limit-ask = false; Shared.select-limit(root.limit-new); }
                    }
                }
            }
        }
    }

    // Toast wie Mountpoints .toast: unten mittig (44 über dem Rand), so breit wie der Text, gleitet von unten herein
    if root.toast-text != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.toast-visible ? root.height - self.height - 44px : root.height;
        opacity: root.toast-visible ? 1 : 0;
        animate y, opacity { duration: 200ms; easing: ease-out; }
        width: min(measure.preferred-width, root.width - 60px) + 28px;
        // ungebrochene Breite des Textes (der Toast ist so breit wie sein Text, höchstens fast fensterbreit)
        measure := Text { visible: false; text: root.toast-text; font-size: 11px; font-weight: 600; }
        height: toast.preferred-height + 18px;
        border-radius: 8px;
        background: root.toast-ok ? Theme.online : Theme.background;
        border-width: root.toast-ok ? 0px : 1px;
        border-color: Theme.partial;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        toast := Text {
            width: parent.width - 28px;
            text: root.toast-text;
            wrap: word-wrap;
            font-size: 11px;
            font-weight: 600;
            color: root.toast-ok ? Theme.on-primary : Theme.text;
            accessible-role: text;
        }
    }
}

// Avid-Projekte: Überordner wählen, Projekte einschalten, Bins lesen, fehlende Medien auflisten und für Ferry anfordern.
// step: 0 Auswahl, 1 läuft, 2 Ergebnis

// Fehlende Medien bzw. AMA-Clips pro Bin (Projekte › Medien anzeigen…): eigenes, größeres Fenster, das Hauptfenster bleibt gleich groß
export component MediaWindow inherits CheckWindow {
    title: root.kind == 0 ? @tr("Missing media") : @tr("AMA clips");
    width: 900px;
    height: 680px;
    in property <int> kind;
    in property <int> count;
    in property <[MissingRow]> rows;
    callback toggle-group(int);
    callback save-list();
    callback close();
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.kind == 0 ? @tr("{n} media file missing" | "{n} media files missing" % root.count) : @tr("{n} AMA-linked file" | "{n} AMA-linked files" % root.count);
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
            }
            CheckButton {
                text: @tr("Save list…");
                clicked => { root.save-list(); }
            }
            CheckButton {
                text: @tr("Done");
                primary: true;
                clicked => { root.close(); }
            }
        }
        Text {
            text: root.kind == 0 ? @tr("Click a file to see where it is used: master clips, subclips and sequences.") : @tr("Where the AMA-linked clips are used. Click a clip to see its master clips, subclips and sequences. AMA files are not requested.");
            font-size: 12px;
            color: Theme.muted;
        }
        list-area := Rectangle {
            vertical-stretch: 1;
            MissingList {
                y: 0;
                rows: root.rows;
                limit: list-area.height;
                toggle(i) => { root.toggle-group(i); }
            }
        }
    }
}
