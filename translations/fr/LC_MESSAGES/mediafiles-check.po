msgid_plural "{n} files left where they are (changed, or the name exists again): {}"
msgstr[0] "{n} fichier laissé en place (modifié, ou le nom existe de nouveau) : {}"
msgstr[1] "{n} fichiers laissés en place (modifiés, ou le nom existe de nouveau) : {}"

